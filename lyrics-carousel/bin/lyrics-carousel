LANGUAGES = ("en", "es")


def detect_language(choice: str = "auto") -> str:
    """Idioma de los textos de la ventana.

    "auto" mira el idioma del sistema. Si no dice nada, ingles: el plugin
    esta en ingles y el usuario que lo quiera en espanol lo pide con
    --lang es o con el ajuste `language`.
    """
    value = str(choice or "auto").strip().lower()
    if value in LANGUAGES:
        return value
    for variable in ("LC_ALL", "LC_MESSAGES", "LANG"):
        locale = os.environ.get(variable, "").strip()
        if locale:
            return "es" if locale.lower().startswith("es") else "en"
    return "en"

# --------------------------------------------------------------------------
# utilidades
# --------------------------------------------------------------------------

ANSI_RE = re.compile(r"\x1b\[[0-9;]*m")


def strip_ansi(value: str) -> str:
    return ANSI_RE.sub("", value)


def cell_width(value: str) -> int:
    """Ancho en celdas de terminal (sin ANSI)."""
    value = strip_ansi(value)
    total = 0
    for char in value:
        if unicodedata.combining(char):
            continue
        if unicodedata.east_asian_width(char) in ("W", "F"):
            total += 2
        else:
            total += 1
    return total


def truncate(value: str, width: int, ellipsis: str = "…") -> str:
    if width <= 0:
        return ""
    if cell_width(value) <= width:
        return value
    ell = cell_width(ellipsis)
    limit = max(0, width - ell)
    out = []
    used = 0
    for char in value:
        char_width = 0 if unicodedata.combining(char) else (
            2 if unicodedata.east_asian_width(char) in ("W", "F") else 1
        )
        if used + char_width > limit:
            break
        out.append(char)
        used += char_width
    return "".join(out).rstrip() + (ellipsis if width >= ell else "")


def normalize_text(value: str) -> str:
    value = unicodedata.normalize("NFC", value or "")
    value = value.replace("\t", " ").replace("\r", " ").replace("\n", " ")
    value = "".join(ch for ch in value if ch == " " or unicodedata.category(ch)[0] != "C")
    return re.sub(r"\s+", " ", value).strip()


def mmss(seconds: float) -> str:
    seconds = max(0, int(seconds or 0))
    return f"{seconds // 60:02d}:{seconds % 60:02d}"


def clamp(value: float, low: float, high: float) -> float:
    return max(low, min(high, value))


def blend(a, b, t: float):
    t = clamp(t, 0.0, 1.0)
    return (
        int(a[0] + (b[0] - a[0]) * t),
        int(a[1] + (b[1] - a[1]) * t),
        int(a[2] + (b[2] - a[2]) * t),
    )


def parse_hex(value, fallback=(255, 255, 255)):
    """Convierte "#rrggbb" o "rrggbb" en una tupla RGB."""
    text = str(value or "").strip().lstrip("#")
    if len(text) == 3:
        text = "".join(char * 2 for char in text)
    if len(text) != 6:
        return fallback
    try:
        return tuple(int(text[i : i + 2], 16) for i in (0, 2, 4))
    except ValueError:
        return fallback


def fg(color, bold: bool = False, italic: bool = False) -> str:
    codes = []
    if bold:
        codes.append("1")
    if italic:
        codes.append("3")
    codes.append(f"38;2;{color[0]};{color[1]};{color[2]}")
    return "\x1b[" + ";".join(codes) + "m"


RESET = "\x1b[0m"


# --------------------------------------------------------------------------
# tema (lee los colores reales de kitty, incluido el include de Noctalia)
# --------------------------------------------------------------------------

ACCENT_NAMES = (
    "primary", "red", "green", "yellow", "blue", "magenta", "cyan", "custom",
)


class Theme:
    """Colores del tema de kitty que Noctalia genera desde el wallpaper.

    El template de kitty exporta la paleta ANSI (color0..color15) y el color
    primario del sistema en active_border_color/url_color; los colores
    "primary", "green"... se mapean a esos valores para que el widget siga al
    fondo de pantalla.
    """

    COLOR_KEYS = {
        "foreground",
        "background",
        "color0",
        "color1",
        "color2",
        "color3",
        "color4",
        "color5",
        "color6",
        "color7",
        "color8",
        "color15",
        "selection_background",
        "active_border_color",
        "url_color",
        "active_tab_background",
        "inactive_border_color",
    }

    def __init__(self):
        self.foreground = (243, 242, 242)
        self.background = (31, 31, 31)
        self.accent = (228, 103, 103)
        self.past = (105, 105, 105)
        self.bright = (243, 242, 242)
        self.faint = (150, 146, 146)
        self.accents = {
            "primary": self.accent,
            "red": self.accent,
            "green": (110, 204, 111),
            "yellow": (217, 228, 103),
            "blue": (102, 204, 111),
            "magenta": (228, 236, 147),
            "cyan": (184, 233, 150),
        }
        self.source = ""
        self.reload()

    @staticmethod
    def _parse_hex(value: str):
        value = value.strip().strip('"').strip("'")
        if not value.startswith("#"):
            return None
        value = value[1:]
        if len(value) == 3:
            value = "".join(ch * 2 for ch in value)
        if len(value) != 6:
            return None
        try:
            return tuple(int(value[i : i + 2], 16) for i in (0, 2, 4))
        except ValueError:
            return None

    def reload(self):
        paths = []
        base = os.path.join(
            os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
            "kitty",
            "kitty.conf",
        )
        seen = set()

        def read_config(path: str, depth: int = 0):
            if depth > 3 or not os.path.isfile(path) or path in seen:
                return
            seen.add(path)
            try:
                with open(path, encoding="utf-8", errors="replace") as handle:
                    lines = handle.readlines()
            except OSError:
                return
            for raw in lines:
                line = raw.strip()
                if not line or line.startswith("#"):
                    continue
                if line.startswith("include "):
                    include = line.split(None, 1)[1].strip().strip('"').strip("'")
                    include = os.path.expanduser(include)
                    if not os.path.isabs(include):
                        include = os.path.join(os.path.dirname(path), include)
                    read_config(include, depth + 1)
                    continue
                parts = line.split(None, 1)
                if len(parts) != 2:
                    continue
                key, value = parts[0].lower(), parts[1].strip()
                if key in self.COLOR_KEYS:
                    color = self._parse_hex(value)
                    if color is not None:
                        paths.append((key, color))

        read_config(base)
        colors = dict(paths)
        self.foreground = colors.get("foreground", self.foreground)
        self.background = colors.get("background", self.background)
        self.past = colors.get("color8", self.past)
        self.bright = colors.get("color15") or colors.get("color7") or self.bright
        self.faint = blend(self.foreground, self.background, 0.45)

        # El primario del sistema lo exporta Noctalia como color de borde.
        primary = (
            colors.get("active_border_color")
            or colors.get("url_color")
            or colors.get("active_tab_background")
        )
        self.accents["primary"] = primary or self.accent
        self.accents["red"] = colors.get("color1", self.accents["red"])
        self.accents["green"] = colors.get("color2", self.accents["green"])
        self.accents["yellow"] = colors.get("color3", self.accents["yellow"])
        self.accents["blue"] = colors.get("color4", self.accents["blue"])
        self.accents["magenta"] = colors.get("color5", self.accents["magenta"])
        self.accents["cyan"] = colors.get("color6", self.accents["cyan"])
        self.accent = self.accents["primary"]

    def color(self, base, fade: float = 1.0):
        return blend(self.background, base, fade)

    def accent_color(self, cfg):
        """Color del renglón activo según el ajuste `accent`."""
        name = cfg.get("accent", "primary")
        if name == "custom":
            return parse_hex(cfg.get("custom_color", ""), self.accent)
        return self.accents.get(name, self.accent)


# --------------------------------------------------------------------------
# reproductor
# --------------------------------------------------------------------------

class Track:
    __slots__ = ("title", "artist", "album", "duration", "player", "status", "position", "stamp")

    def __init__(self, title="", artist="", album="", duration=0.0, player="", status="Stopped"):
        self.title = title
        self.artist = artist
        self.album = album
        self.duration = duration
        self.player = player
        self.status = status
        self.position = 0.0
        self.stamp = 0.0

    @property
    def key(self) -> str:
        return "|".join(
            (normalize_text(self.title), normalize_text(self.artist), normalize_text(self.album), str(int(self.duration)))
        )

    @property
    def playing(self) -> bool:
        return self.status == "Playing"

    def current_position(self) -> float:
        pos = self.position
        if self.playing and self.stamp:
            pos += time.monotonic() - self.stamp
        if self.duration > 0:
            pos = min(pos, self.duration)
        return max(0.0, pos)


class PlayerWatcher:
    FORMAT = (
        "{{playerName}}\t{{playerInstance}}\t{{status}}\t{{title}}\t"
        "{{artist}}\t{{album}}\t{{mpris:length}}\t{{position}}"
    )

    def __init__(self, preferred: str = ""):
        self.preferred = preferred
        self.track = Track()
        self.previous: Track | None = None
        self._selected = ""
        self._last_poll = 0.0

    @staticmethod
    def _run(args, timeout=2.0):
        try:
            return subprocess.run(
                args,
                capture_output=True,
                text=True,
                timeout=timeout,
                check=False,
            )
        except (OSError, subprocess.SubprocessError):
            return None

    def _candidates(self):
        result = self._run(["playerctl", "-a", "metadata", "--format", self.FORMAT])
        if result is None or not result.stdout.strip():
            return []
        candidates = []
        for raw in result.stdout.splitlines():
            parts = raw.split("\t")
            if len(parts) < 8:
                continue
            name, instance, status, title, artist, album, length, position = parts[:8]
            title = normalize_text(title)
            artist = normalize_text(artist)
            if not title and not artist:
                continue
            try:
                duration = float(length) / 1_000_000.0
            except ValueError:
                duration = 0.0
            try:
                pos = float(position) / 1_000_000.0
            except ValueError:
                pos = 0.0
            rank = 2 if status == "Playing" else 1 if status == "Paused" else 0
            preferred = instance if instance else name
            match = 1 if preferred == self.preferred or name == self.preferred else 0
            candidates.append(
                (
                    rank,
                    match,
                    1 if preferred == self._selected else 0,
                    Track(title, artist, normalize_text(album), duration, preferred, status),
                    pos,
                )
            )
        candidates.sort(key=lambda item: (-item[0], -item[1], -item[2], item[3].key))
        return candidates

    def poll(self, force: bool = False) -> Track | None:
        now = time.monotonic()
        if not force and now - self._last_poll < 0.35:
            return None
        self._last_poll = now

        candidates = self._candidates()
        if not candidates:
            self._selected = ""
            if self.track.title or self.track.artist:
                self.previous, self.track = self.track, Track()
                return self.track
            return None

        _, _, _, fresh, measured = candidates[0]
        self._selected = fresh.player
        old = self.track
        changed = (
            fresh.key != old.key
            or fresh.status != old.status
            or fresh.player != old.player
        )
        fresh.stamp = now
        # El metadata de MPRIS se actualiza a saltos; conservamos la
        # extrapolación si la diferencia es pequeña para no vibrar.
        if changed:
            fresh.position = measured
        else:
            estimate = old.current_position()
            if abs(estimate - measured) > 0.75:
                fresh.position = measured
            else:
                fresh.position = old.position
                fresh.stamp = old.stamp
        self.previous, self.track = old, fresh
        return fresh


# --------------------------------------------------------------------------
# letras
# --------------------------------------------------------------------------

# Los minutos admiten tres digitos ([100:00] son 100 minutos): con dos, una
# letra larga se descartaba entera. Las horas se distinguen por el segundo
# grupo de dos puntos ([01:02:03] es una hora, dos minutos y tres segundos).
LRC_TAG = re.compile(r"\[(?:(\d{1,3}):)?(\d{1,3}):(\d{1,2})(?:[.:](\d{1,6}))?\]")
LRC_OFFSET = re.compile(r"\[offset:([+-]?\d+)\]", re.I)
# Solo las etiquetas de tiempo mejoradas (<00:12.34>): un patron generico
# <[^>]*> se comia texto normal entre angulos, como "I <3 you > me".
ENHANCED_TAG = re.compile(r"<\d{1,3}:\d{1,2}(?:[.:]\d{1,6})?>")


class LyricLine:
    __slots__ = ("start", "duration", "text", "chars")

    def __init__(self, start: float, duration: float, text: str, chars=None):
        self.start = float(start)
        if self.start < 0:
            self.start = -1.0
        self.duration = max(0.0, float(duration or 0))
        self.text = normalize_text(text)
        self.chars = chars or []

    def as_json(self):
        out = [round(self.start, 3), round(self.duration, 3), self.text]
        if self.chars:
            out.append([round(value, 3) for value in self.chars])
        return out

    @classmethod
    def from_json(cls, value):
        if not isinstance(value, list) or len(value) < 3:
            return None
        chars = value[3] if len(value) > 3 and isinstance(value[3], list) else []
        text = normalize_text(str(value[2]))
        if not text:
            return None
        return cls(float(value[0]), float(value[1]), text, chars)


def parse_lrc(text: str):
    text = (text or "").replace("\r\n", "\n").replace("\r", "\n")
    offset = 0.0
    match = LRC_OFFSET.search(text)
    if match:
        try:
            offset = int(match.group(1)) / 1000.0
        except ValueError:
            offset = 0.0

    found = {}
    for raw in text.splitlines():
        raw = raw.strip()
        if not raw:
            continue
        tags = list(LRC_TAG.finditer(raw))
        if not tags:
            continue
        body = ENHANCED_TAG.sub("", LRC_TAG.sub("", raw)).strip()
        if not body:
            continue
        if re.match(r"^(ar|al|ti|by|re|ve|length|offset):", body, re.I):
            continue
        for tag in tags:
            hours = int(tag.group(1) or 0)
            minutes = int(tag.group(2))
            seconds = float(tag.group(3))
            fraction = tag.group(4) or "0"
            # Hasta seis decimales: algunos LRC traen microsegundos.
            fraction_value = int(fraction) / (10 ** len(fraction))
            start = hours * 3600 + minutes * 60 + seconds + fraction_value + offset
            if start < 0:
                continue
            found[round(start, 3)] = body

    lines = []
    times = sorted(found)
    for index, start in enumerate(times):
        end = times[index + 1] if index + 1 < len(times) else start + 6.0
        duration = clamp(end - start, 0.0, 10.0)
        lines.append(LyricLine(start, duration, found[start]))
    return lines


CREDIT_RE = re.compile(
    r"^(lyrics?\s+by|composed\s+by|written\s+by|produced\s+by|arranged\s+by|"
    r"lyricist|composer|arranger|作词|作曲|编曲|制作人)\s*[:：]",
    re.I,
)


def clean_lyric_lines(lines):
    result = []
    for line in lines or []:
        if not line.text or CREDIT_RE.match(line.text):
            continue
        if (
            result
            and line.text == result[-1].text
            and abs(line.start - result[-1].start) < 0.35
        ):
            continue
        result.append(line)
    return result


def plain_lines(text: str, duration: float):
    raw = [
        normalize_text(line)
        for line in (text or "").splitlines()
        if normalize_text(line)
    ]
    if not raw:
        return []
    if duration > 20:
        start = min(6.0, duration * 0.05)
        end = max(start + 1, duration - 4.0)
        step = (end - start) / max(1, len(raw))
    else:
        start = 1.0
        step = 4.0
    lines = []
    for index, value in enumerate(raw):
        lines.append(LyricLine(start + index * step, step * 0.92, value))
    return lines


def _normalize_match(value: str) -> str:
    value = unicodedata.normalize("NFKD", value or "")
    value = "".join(ch for ch in value if not unicodedata.combining(ch))
    return "".join(ch.lower() for ch in value if ch.isalnum())


def _http_json(url: str, headers=None, timeout=12.0):
    request = urllib.request.Request(
        url,
        headers={
            "User-Agent": f"{APP}/{VERSION}",
            "Accept": "application/json",
            **(headers or {}),
        },
    )
    with urllib.request.urlopen(request, timeout=timeout) as response:
        payload = response.read().decode("utf-8", "replace")
    return json.loads(payload)


def fetch_lrclib(track: Track, log):
    params = {
        "track_name": track.title,
        "artist_name": track.artist,
    }
    if track.album:
        params["album_name"] = track.album
    url = "https://lrclib.net/api/search?" + urllib.parse.urlencode(params)
    try:
        data = _http_json(url, timeout=3.0)
    except urllib.error.HTTPError as error:
        log(f"lrclib HTTP {error.code}")
        return [], f"http {error.code}"
    except Exception as error:  # noqa: BLE001
        log(f"lrclib error: {error!r}")
        return [], "red"
    if not isinstance(data, list) or not data:
        log("lrclib sin resultados")
        return [], None

    wanted_title = _normalize_match(track.title)
    wanted_artist = _normalize_match(track.artist)
    best = None
    best_score = -1.0
    for candidate in data:
        if not isinstance(candidate, dict):
            continue
        ctitle = _normalize_match(candidate.get("trackName", ""))
        cartist = _normalize_match(candidate.get("artistName", ""))
        synced = bool(candidate.get("syncedLyrics"))
        score = 0.0
        if ctitle == wanted_title:
            score += 5.0
        elif ctitle and (ctitle in wanted_title or wanted_title in ctitle):
            score += 2.5
        if wanted_artist and cartist:
            if cartist == wanted_artist:
                score += 4.0
            elif wanted_artist in cartist or cartist in wanted_artist:
                score += 2.0
            else:
                # artistas separados por comas: basta con uno en común
                wanted_parts = {part.strip() for part in track.artist.split(",") if part.strip()}
                if any(_normalize_match(part) in cartist for part in wanted_parts):
                    score += 1.5
        if synced:
            score += 3.0
        try:
            cduration = float(candidate.get("duration") or 0)
            if track.duration > 0 and cduration > 0:
                score += max(0.0, 2.0 - abs(cduration - track.duration) / 20.0)
        except (TypeError, ValueError):
            pass
        if score > best_score:
            best_score = score
            best = candidate

    if best is None:
        return [], None
    lrc = best.get("syncedLyrics") or ""
    if lrc:
        lines = parse_lrc(lrc)
        if lines:
            log(f"lrclib: {best.get('trackName')} / {best.get('artistName')} (sync)")
            return lines, None
    plain = best.get("plainLyrics") or ""
    if plain:
        lines = plain_lines(plain, track.duration)
        if lines:
            log(f"lrclib: {best.get('trackName')} / {best.get('artistName')} (plain)")
            return lines, None
    return [], None


def fetch_netease(track: Track, log):
    query = f"{track.title} {track.artist}".strip()
    if not query:
        return []
    search_url = "https://music.163.com/api/search/get?" + urllib.parse.urlencode(
        {"type": 1, "s": query, "limit": 5}
    )
    try:
        data = _http_json(search_url, headers={"Referer": "https://music.163.com"}, timeout=10.0)
    except Exception as error:  # noqa: BLE001
        log(f"netease búsqueda: {error!r}")
        return [], "red"
    songs = (((data or {}).get("result") or {}).get("songs") or []) if isinstance(data, dict) else []
    if not songs:
        log("netease sin resultados")
        return [], None

    wanted_title = _normalize_match(track.title)
    wanted_artist = _normalize_match(track.artist)
    chosen = None
    best_score = -1.0
    for song in songs:
        if not isinstance(song, dict):
            continue
        title = _normalize_match(song.get("name", ""))
        artists = " ".join(
            _normalize_match(artist.get("name", ""))
            for artist in (song.get("artists") or [])
            if isinstance(artist, dict)
        )
        score = 0.0
        if title == wanted_title:
            score += 4.0
        elif title and (title in wanted_title or wanted_title in title):
            score += 2.0
        if wanted_artist and artists and (wanted_artist in artists or artists in wanted_artist):
            score += 3.0
        if score > best_score:
            best_score = score
            chosen = song
    if not chosen:
        return [], None
    song_id = str(chosen.get("id") or "")
    if not song_id.isdigit():
        return [], None
    lyric_url = "https://music.163.com/api/song/lyric?" + urllib.parse.urlencode(
        {"id": song_id, "lv": 1, "kv": 1, "tv": -1}
    )
    try:
        data = _http_json(lyric_url, headers={"Referer": "https://music.163.com"}, timeout=10.0)
    except Exception as error:  # noqa: BLE001
        log(f"netease letra: {error!r}")
        return [], "red"
    lrc = (((data or {}).get("lrc") or {}).get("lyric") or "") if isinstance(data, dict) else ""
    lines = parse_lrc(lrc)
    if lines:
        log(f"netease: {chosen.get('name')} (sync)")
        return lines, None
    # Algunas canciones solo traen la letra "traducida" o texto plano.
    text = ENHANCED_TAG.sub("", lrc).strip()
    if text:
        lines = plain_lines(text, track.duration)
        if lines:
            log(f"netease: {chosen.get('name')} (plain)")
            return lines, None
    return [], None


def find_lyric_adapter():
    roots = [
        os.path.join(state_dir(), "plugins", "materialized"),
        os.path.expanduser("~/.local/share/noctalia/plugins"),
    ]
    for root in roots:
        if not os.path.isdir(root):
            continue
        for current, dirs, files in os.walk(root):
            if "lyric_sources.py" in files and "music_sources.py" in files:
                return os.path.join(current, "lyric_sources.py")
    return ""


def fetch_adapter(track: Track, log):
    script = find_lyric_adapter()
    if not script:
        return [], None
    workdir = os.path.dirname(script)
    sources = ("splayer", "qqmusic", "kugou")
    failed = False
    for source in sources:
        request = {
            "source": source,
            "track": {
                "title": track.title,
                "artist": track.artist,
                "album": track.album,
                "duration": int(track.duration * 1_000_000),
            },
            "options": {},
        }
        path = ""
        try:
            fd, path = tempfile.mkstemp(prefix="lyrics-", suffix=".json", dir=CACHE_DIR)
            with os.fdopen(fd, "w", encoding="utf-8") as handle:
                json.dump(request, handle)
            result = subprocess.run(
                [sys.executable, script, path],
                cwd=workdir,
                capture_output=True,
                text=True,
                timeout=22,
                check=False,
            )
            if not result.stdout.strip():
                log(f"{source}: sin salida")
                failed = True
                continue
            data = json.loads(result.stdout)
            raw = data.get("lines") if isinstance(data, dict) else None
            if not raw:
                diag = data.get("diag") if isinstance(data, dict) else None
                log(f"{source}: {diag}")
                continue
            lines = []
            for item in raw:
                if not isinstance(item, dict):
                    continue
                text = normalize_text(item.get("text", ""))
                if not text and item.get("translation"):
                    text = normalize_text(item.get("translation", ""))
                if not text:
                    continue
                start = float(item.get("time", -1))
                duration = float(item.get("duration", 0))
                if start > 10_000:
                    start /= 1000.0
                    duration /= 1000.0
                elif start < 0:
                    continue
                chars = item.get("chars") or []
                if chars and isinstance(chars, list):
                    chars = [float(value) / 1000.0 for value in chars]
                lines.append(LyricLine(start, duration, text, chars))
            if lines:
                log(f"{source}: {len(lines)} líneas")
                return lines, None
        except subprocess.TimeoutExpired:
            log(f"{source}: timeout")
            failed = True
        except Exception as error:  # noqa: BLE001
            log(f"{source}: {error!r}")
            failed = True
        finally:
            if path and os.path.exists(path):
                try:
                    os.remove(path)
                except OSError:
                    pass
    return [], ("red" if failed else None)


def load_lyrics_settings():
    """Lee los ajustes del plugin Lyrics de Noctalia si están disponibles."""
    result = {
        "sources": ["lrclib", "netease", "splayer", "qqmusic", "kugou"],
        "credentials": {},
        "translation": "zh-Hans",
    }
    # El estado puede estar movido con NOCTALIA_STATE_HOME o XDG_STATE_HOME:
    # una ruta fija leeria los ajustes de otra instalacion.
    path = os.path.join(state_dir(), "settings.toml")
    if not os.path.isfile(path) or tomllib is None:
        return result
    try:
        with open(path, "rb") as handle:
            data = tomllib.load(handle)
    except Exception:  # noqa: BLE001
        return result
    section = (data.get("plugin_settings") or {}).get('h465855hgg/lyrics') or {}
    sources = section.get("lyrics_sources")
    if isinstance(sources, list) and sources:
        result["sources"] = [str(item).strip().lower() for item in sources if str(item).strip()]
    result["translation"] = str(section.get("translation_language") or result["translation"])
    for key in (
        "spotify_sp_dc", "spotify_access_token", "apple_developer_token",
        "apple_user_token", "apple_storefront", "musixmatch_token",
        "qishui_token", "qishui_api_url", "splayer_api_url",
    ):
        value = section.get(key)
        if value is not None:
            result["credentials"][key] = str(value)
    return result


def adapter_track(track: Track, art_url: str = ""):
    return {
        "title": track.title,
        "artist": track.artist,
        "album": track.album,
        "duration": int(track.duration * 1_000_000),
        "artUrl": art_url,
    }


def adapter_request(source: str, track: Track, settings: dict):
    creds = dict(settings.get("credentials", {}))
    if source == "splayer":
        creds.setdefault(
            "splayer_api_url",
            settings.get("credentials", {}).get("splayer_api_url", "http://127.0.0.1:25884"),
        )
    request = {
        "source": source,
        "track": adapter_track(track),
        "credentials": creds,
        "options": {"translation_language": settings.get("translation", "zh-Hans")},
    }
    return request


def run_adapter(source: str, track: Track, settings: dict, log):
    script = find_lyric_adapter()
    if not script:
        return [], None
    workdir = os.path.dirname(script)
    request = adapter_request(source, track, settings)
    path = ""
    try:
        fd, path = tempfile.mkstemp(prefix="lyrics-", suffix=".json", dir=CACHE_DIR)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(request, handle)
        result = subprocess.run(
            [sys.executable, script, path],
            cwd=workdir,
            capture_output=True,
            text=True,
            # NetEase y QQ Music pueden tardar mas de 3 s: matarlos dejaba
            # sin letra canciones que el adaptador si sabia resolver.
            timeout=22,
            check=False,
        )
        if not result.stdout.strip():
            log(f"{source}: sin salida")
            return [], "red"
        data = json.loads(result.stdout)
        if not isinstance(data, dict):
            return [], None
        raw = data.get("lines")
        if not raw:
            diag = data.get("diag") if isinstance(data.get("diag"), list) else []
            log(f"{source}: {diag}")
            return [], None
        lines = []
        for item in raw:
            if not isinstance(item, dict):
                continue
            text = normalize_text(item.get("text", ""))
            if not text and item.get("translation"):
                text = normalize_text(item.get("translation", ""))
            if not text:
                continue
            start = float(item.get("time", -1))
            duration = float(item.get("duration", 0))
            # El adaptador siempre devuelve milisegundos (-1 = sin tiempo).
            if start < 0:
                start = -1.0
            else:
                start /= 1000.0
            if duration > 0:
                duration /= 1000.0
            chars = item.get("chars") or []
            if chars and isinstance(chars, list):
                chars = [float(value) / 1000.0 for value in chars]
            lines.append(LyricLine(start, duration, text, chars))
        if lines:
            log(f"{source}: {len(lines)} líneas")
            return lines, None
        return [], None
    except subprocess.TimeoutExpired:
        log(f"{source}: timeout")
        return [], "red"
    except Exception as error:  # noqa: BLE001
        log(f"{source}: {error!r}")
        return [], "red"
    finally:
        if path and os.path.exists(path):
            try:
                os.remove(path)
            except OSError:
                pass

def cache_key(track: Track) -> str:
    raw = "\n".join(
        (
            normalize_text(track.title).casefold(),
            normalize_text(track.artist).casefold(),
            normalize_text(track.album).casefold(),
            str(int(track.duration)),
        )
    )
    return hashlib.sha1(raw.encode("utf-8")).hexdigest()[:24]


def load_cache(track: Track):
    os.makedirs(CACHE_DIR, exist_ok=True)
    path = os.path.join(CACHE_DIR, cache_key(track) + ".json")
    if not os.path.isfile(path):
        return None
    try:
        with open(path, encoding="utf-8") as handle:
            data = json.load(handle)
        if not isinstance(data, dict):
            return None
        lines = [LyricLine.from_json(value) for value in data.get("lines", [])]
        lines = [line for line in lines if line and line.text]
        if lines:
            return lines, data.get("source", "cache"), bool(data.get("synced", True))
    except (OSError, ValueError):
        pass
    return None


def save_cache(track: Track, lines, source: str, synced: bool):
    os.makedirs(CACHE_DIR, exist_ok=True)
    path = os.path.join(CACHE_DIR, cache_key(track) + ".json")
    payload = {
        "title": track.title,
        "artist": track.artist,
        "album": track.album,
        "duration": round(track.duration, 2),
        "source": source,
        "synced": bool(synced),
        "saved": int(time.time()),
        "lines": [line.as_json() for line in lines],
    }
    try:
        with open(path, "w", encoding="utf-8") as handle:
            json.dump(payload, handle, ensure_ascii=False, separators=(",", ":"))
    except OSError:
        pass


def mark_missing(track: Track):
    os.makedirs(CACHE_DIR, exist_ok=True)
    path = os.path.join(CACHE_DIR, cache_key(track) + ".none")
    try:
        with open(path, "w", encoding="utf-8") as handle:
            handle.write(str(int(time.time())))
    except OSError:
        pass


def missing_recent(track: Track, hours=0.4) -> bool:
    path = os.path.join(CACHE_DIR, cache_key(track) + ".none")
    try:
        if not os.path.isfile(path):
            return False
        with open(path, encoding="utf-8") as handle:
            saved = int(handle.read().strip() or 0)
        return time.time() - saved < hours * 3600
    except (OSError, ValueError):
        return False


def estimate_times(lines, duration: float):
    """Asigna tiempos estimados solo a las líneas sin marca temporal.

    Una letra puede traer unas líneas con tiempo (LRC a medias) y otras sin
    él: pisar las que ya lo tienen descoloca el resaltado y la letra deja de
    seguir la canción.

    Las líneas sin tiempo se reparten por el hueco que les toca según su
    posición en la lista: entre dos líneas con tiempo se quedan en medio,
    detrás de la última si van al final y antes de la primera si van al
    principio. Repartirlas todas desde el principio (como se hacía) deja que
    una línea del final de la lista empiece a sonar en el segundo 6, por
    delante de la parte que sí tiene tiempos.
    """
    sin_tiempo = [
        (index, line)
        for index, line in enumerate(lines)
        if line.text and line.start < 0
    ]
    if not sin_tiempo:
        return lines

    # Hueco por defecto entre líneas: cuatro segundos.
    #
    # No se deriva de la duración: con una canción de 200 s y una línea
    # sin tiempo al final, un hueco de 196 s la colocaba en el segundo 226
    # (fuera de la canción, así que nunca se resaltaba). El hueco es fijo
    # y el reparto se recorta al final, donde haga falta.
    hueco = 4.0

    # Anclas: las líneas con tiempo real y su posición en la lista.
    anclas = [
        (index, line.start)
        for index, line in enumerate(lines)
        if line.start >= 0
    ]

    # Cada línea sin tiempo se asigna al hueco que la rodea (la anterior con
    # tiempo y la siguiente con tiempo).
    grupos = []
    for indice, linea in sin_tiempo:
        antes = None
        despues = None
        for pos, inicio in anclas:
            if pos < indice and (antes is None or pos > antes[0]):
                antes = (pos, inicio)
            if pos > indice and (despues is None or pos < despues[0]):
                despues = (pos, inicio)
        for grupo in grupos:
            if grupo["antes"] == antes and grupo["despues"] == despues:
                grupo["lineas"].append(linea)
                break
        else:
            grupos.append(
                {"antes": antes, "despues": despues, "lineas": [linea]}
            )

    for grupo in grupos:
        miembros = grupo["lineas"]
        antes = grupo["antes"]
        despues = grupo["despues"]
        total = len(miembros)
        if antes and despues:
            # Entre dos líneas con tiempo: se reparten el hueco intermedio.
            span = despues[1] - antes[1]
            paso = span / (total + 1) if span > 0 else hueco
            if paso <= 0:
                paso = hueco
            for indice, linea in enumerate(miembros):
                linea.start = antes[1] + (indice + 1) * paso
                if linea.duration <= 0:
                    linea.duration = paso * 0.92
        elif antes:
            # Detrás de la última línea con tiempo. Si la canción se sabe
            # y no caben todas las líneas antes de que termine, el paso se
            # recorta: una línea fuera de la canción nunca se resaltaba.
            paso = hueco
            if duration and duration > antes[1]:
                paso = min(hueco, (duration - antes[1]) / (total + 1))
            for indice, linea in enumerate(miembros):
                linea.start = antes[1] + (indice + 1) * paso
                if linea.duration <= 0:
                    linea.duration = max(0.1, paso * 0.92)
        elif despues:
            # Antes de la primera línea con tiempo. Se reparte hacia atrás
            # sin salirse del origen: si no, varias líneas sin tiempo
            # delante de una real muy temprana acaban todas en el segundo
            # 0 y se resaltan a la vez.
            inicio = max(0.0, despues[1] - total * hueco)
            paso = (despues[1] - inicio) / (total + 1)
            if paso <= 0:
                # La línea real llega en el segundo 0: no hay hueco antes,
                # pero al menos las líneas no comparten el mismo instante.
                paso = 0.001
            for indice, linea in enumerate(miembros):
                linea.start = inicio + indice * paso
                if linea.duration <= 0:
                    linea.duration = max(0.1, paso * 0.92)
        else:
            # Ninguna línea tiene tiempo: se reparte desde el principio.
            if duration and duration > 20:
                inicio = min(6.0, duration * 0.05)
                fin = max(inicio + 1, duration - 4.0)
                paso = (fin - inicio) / max(1, total)
            else:
                inicio = 1.0
                paso = 4.0
            for indice, linea in enumerate(miembros):
                linea.start = inicio + indice * paso
                if linea.duration <= 0:
                    linea.duration = paso * 0.92
    return lines


def fetch_lyrics(track: Track, force: bool, log):
    if not force:
        cached = load_cache(track)
        if cached:
            lines, source, synced = cached
            log(f"cache: {len(lines)} líneas ({source})")
            return lines, source, synced
        if missing_recent(track):
            log("sin letra (caché negativa)")
            return [], "cache", False

    settings = load_lyrics_settings()
    sources = list(settings.get("sources") or ["lrclib", "netease"])
    # Filtra las fuentes que necesitan credenciales ausentes.
    available = []
    for source in sources:
        source = source.strip().lower()
        if source in ("spotify",) and not (
            settings.get("credentials", {}).get("spotify_sp_dc")
            or settings.get("credentials", {}).get("spotify_access_token")
        ):
            continue
        if source in ("apple_music",) and not (
            settings.get("credentials", {}).get("apple_developer_token")
            or settings.get("credentials", {}).get("apple_user_token")
        ):
            continue
        if source in ("musixmatch",) and not settings.get("credentials", {}).get("musixmatch_token"):
            continue
        if source in ("qishui",) and not settings.get("credentials", {}).get("qishui_api_url"):
            continue
        if source not in available:
            available.append(source)

    # Trabajadores en paralelo: el primero que encuentra letra gana.
    result = {"lines": None, "source": "", "synced": False}
    result_lock = threading.Lock()
    result_event = threading.Event()

    def publish(lines, source):
        lines = clean_lyric_lines(lines)
        if not lines:
            return False
        lines = estimate_times(lines, track.duration)
        synced = len(lines) > 1 and any(line.start >= 0 for line in lines)
        with result_lock:
            if result["lines"] is None:
                result["lines"] = lines
                result["source"] = source
                result["synced"] = synced
                result_event.set()
                # Solo el ganador escribe la cache: si escribieran todos,
                # el ultimo en llegar podia dejar la letra perdedora.
                try:
                    save_cache(track, lines, source, synced)
                except Exception:  # noqa: BLE001
                    pass
        return True

    def worker_builtin_lrclib():
        for attempt in (0, 1):
            try:
                lines, error = fetch_lrclib(track, log)
            except Exception as exc:  # noqa: BLE001
                log(f"lrclib: excepción {exc!r}")
                return
            if lines:
                publish(lines, "lrclib")
                return
            if error is None:
                return
            if attempt == 0:
                time.sleep(1.0)

    def worker_adapter(source):
        try:
            lines, error = run_adapter(source, track, settings, log)
            if lines:
                publish(lines, source)
        except Exception as exc:  # noqa: BLE001
            log(f"{source}: excepción {exc!r}")

    threads = []
    for source in available:
        if source == "lrclib":
            t = threading.Thread(target=worker_builtin_lrclib, daemon=True)
        else:
            t = threading.Thread(target=worker_adapter, args=(source,), daemon=True)
        threads.append(t)

    if not threads:
        mark_missing(track)
        return [], "", False

    for t in threads:
        t.start()

    # Espera al primer éxito o a que todos terminen (máx. 15 s).
    #
    # El plazo es largo porque hay proveedores que tardan: con 4 s una
    # letra que tarda 6 s se tiraba a la basura y el usuario se quedaba
    # sin letra pese a estar disponible.
    deadline = time.monotonic() + SEARCH_TIMEOUT
    while not result_event.is_set() and time.monotonic() < deadline:
        if not any(t.is_alive() for t in threads):
            break
        time.sleep(0.1)
    result_event.wait(timeout=0.05)

    # Cancelación best-effort: se dejan terminar los hilos (daemon).
    with result_lock:
        lines = result["lines"]
        source = result["source"]
        synced = result["synced"]

    if lines:
        return lines, source, synced
    if any(t.is_alive() for t in threads):
        # Se agoto el plazo con proveedores todavia en marcha: la letra
        # puede llegar despues, asi que no se marca la cache negativa
        # (si se marcara, la busqueda se daria por cerrada y no se
        # volveria a mirar esa cancion).
        log("plazo de busqueda agotado: no se marca la cache negativa")
        return [], "", False
    mark_missing(track)
    return [], "", False


class Fetcher:
    def __init__(self, log):
        self.log = log
        self._lock = threading.Lock()
        self._request = None
        self._generation = 0
        self._result = None
        self._thread = threading.Thread(target=self._worker, daemon=True)
        self._thread.start()

    def start(self, track: Track, force: bool = False):
        with self._lock:
            self._generation += 1
            self._request = (track, force, self._generation)
            self._result = None

    def take(self):
        with self._lock:
            result = self._result
            self._result = None
            return result

    def _worker(self):
        while True:
            with self._lock:
                request = self._request
                self._request = None
            if request is None:
                time.sleep(0.08)
                continue
            track, force, generation = request
            try:
                lines, source, synced = fetch_lyrics(track, force, self.log)
            except Exception as error:  # noqa: BLE001
                self.log(f"fetch: {error!r}")
                lines, source, synced = [], "", False
            with self._lock:
                if generation == self._generation:
                    self._result = (lines, source, synced)


