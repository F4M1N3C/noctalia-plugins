LANGUAGES = ("en", "es")


def detect_language(choice: str = "auto") -> str:
    """Idioma de los textos de la ventana.

    "auto" mira el idioma del sistema. Si no dice nada, ingles: el plugin
    esta en ingles y el usuario que lo quiera en espanol lo pide con
    --lang es.
    """
    value = str(choice or "auto").strip().lower()
    if value in LANGUAGES:
        return value
    for variable in ("LC_ALL", "LC_MESSAGES", "LANG"):
        locale = os.environ.get(variable, "").strip()
        if locale:
            return "es" if locale.lower().startswith("es") else "en"
    return "en"

# --------------------------------------------------------------------------
# utilidades
# --------------------------------------------------------------------------


def normalize_text(value: str) -> str:
    value = unicodedata.normalize("NFC", value or "")
    value = value.replace("\t", " ").replace("\r", " ").replace("\n", " ")
    value = "".join(ch for ch in value if ch == " " or unicodedata.category(ch)[0] != "C")
    return re.sub(r"\s+", " ", value).strip()


def clamp(value: float, low: float, high: float) -> float:
    return max(low, min(high, value))


def ease_in_out(progress: float) -> float:
    """Curva suave: empieza y termina sin velocidad (smoothstep).

    Se usa en el desplazamiento del carrusel: el movimiento acelera y frena,
    sin el tirón de una interpolación lineal.
    """
    value = clamp(progress, 0.0, 1.0)
    return value * value * (3.0 - 2.0 * value)


def blend(a, b, t: float):
    t = clamp(t, 0.0, 1.0)
    return (
        int(a[0] + (b[0] - a[0]) * t),
        int(a[1] + (b[1] - a[1]) * t),
        int(a[2] + (b[2] - a[2]) * t),
    )


def parse_hex(value, fallback=(255, 255, 255)):
    """Convierte "#rrggbb" o "rrggbb" en una tupla RGB."""
    text = str(value or "").strip().lstrip("#")
    if len(text) == 3:
        text = "".join(char * 2 for char in text)
    if len(text) != 6:
        return fallback
    try:
        return tuple(int(text[i : i + 2], 16) for i in (0, 2, 4))
    except ValueError:
        return fallback


# --------------------------------------------------------------------------
# tema (lee los colores reales de kitty, incluido el include de Noctalia)
# --------------------------------------------------------------------------

ACCENT_NAMES = (
    "primary", "red", "green", "yellow", "blue", "magenta", "cyan", "custom",
)


class Theme:
    """Colores del tema de kitty que Noctalia genera desde el wallpaper.

    El template de kitty exporta la paleta ANSI (color0..color15) y el color
    primario del sistema en active_border_color/url_color; los colores
    "primary", "green"... se mapean a esos valores para que el widget siga al
    fondo de pantalla.
    """

    COLOR_KEYS = {
        "foreground",
        "background",
        "color0",
        "color1",
        "color2",
        "color3",
        "color4",
        "color5",
        "color6",
        "color7",
        "color8",
        "color15",
        "selection_background",
        "active_border_color",
        "url_color",
        "active_tab_background",
        "inactive_border_color",
    }

    def __init__(self):
        self.foreground = (243, 242, 242)
        self.background = (31, 31, 31)
        self.accent = (228, 103, 103)
        self.past = (105, 105, 105)
        self.bright = (243, 242, 242)
        self.faint = (150, 146, 146)
        self.accents = {
            "primary": self.accent,
            "red": self.accent,
            "green": (110, 204, 111),
            "yellow": (217, 228, 103),
            "blue": (102, 204, 111),
            "magenta": (228, 236, 147),
            "cyan": (184, 233, 150),
        }
        self.source = ""
        self.reload()

    @staticmethod
    def _parse_hex(value: str):
        value = value.strip().strip('"').strip("'")
        if not value.startswith("#"):
            return None
        value = value[1:]
        if len(value) == 3:
            value = "".join(ch * 2 for ch in value)
        if len(value) != 6:
            return None
        try:
            return tuple(int(value[i : i + 2], 16) for i in (0, 2, 4))
        except ValueError:
            return None

    def reload(self):
        paths = []
        base = os.path.join(
            os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
            "kitty",
            "kitty.conf",
        )
        seen = set()

        def read_config(path: str, depth: int = 0):
            if depth > 3 or not os.path.isfile(path) or path in seen:
                return
            seen.add(path)
            try:
                with open(path, encoding="utf-8", errors="replace") as handle:
                    lines = handle.readlines()
            except OSError:
                return
            for raw in lines:
                line = raw.strip()
                if not line or line.startswith("#"):
                    continue
                if line.startswith("include "):
                    include = line.split(None, 1)[1].strip().strip('"').strip("'")
                    include = os.path.expanduser(include)
                    if not os.path.isabs(include):
                        include = os.path.join(os.path.dirname(path), include)
                    read_config(include, depth + 1)
                    continue
                parts = line.split(None, 1)
                if len(parts) != 2:
                    continue
                key, value = parts[0].lower(), parts[1].strip()
                if key in self.COLOR_KEYS:
                    color = self._parse_hex(value)
                    if color is not None:
                        paths.append((key, color))

        read_config(base)
        colors = dict(paths)
        self.foreground = colors.get("foreground", self.foreground)
        self.background = colors.get("background", self.background)
        self.past = colors.get("color8", self.past)
        self.bright = colors.get("color15") or colors.get("color7") or self.bright
        self.faint = blend(self.foreground, self.background, 0.45)

        # El primario del sistema lo exporta Noctalia como color de borde.
        primary = (
            colors.get("active_border_color")
            or colors.get("url_color")
            or colors.get("active_tab_background")
        )
        self.accents["primary"] = primary or self.accent
        self.accents["red"] = colors.get("color1", self.accents["red"])
        self.accents["green"] = colors.get("color2", self.accents["green"])
        self.accents["yellow"] = colors.get("color3", self.accents["yellow"])
        self.accents["blue"] = colors.get("color4", self.accents["blue"])
        self.accents["magenta"] = colors.get("color5", self.accents["magenta"])
        self.accents["cyan"] = colors.get("color6", self.accents["cyan"])
        self.accent = self.accents["primary"]

    def color(self, base, fade: float = 1.0):
        return blend(self.background, base, fade)

    def accent_color(self, cfg):
        """Color del renglón activo según el ajuste `accent`."""
        name = cfg.get("accent", "primary")
        if name == "custom":
            return parse_hex(cfg.get("custom_color", ""), self.accent)
        return self.accents.get(name, self.accent)


# --------------------------------------------------------------------------
# reproductor
# --------------------------------------------------------------------------

class Track:
    __slots__ = ("title", "artist", "album", "duration", "player", "status", "position", "stamp")

    def __init__(self, title="", artist="", album="", duration=0.0, player="", status="Stopped"):
        self.title = title
        self.artist = artist
        self.album = album
        self.duration = duration
        self.player = player
        self.status = status
        self.position = 0.0
        self.stamp = 0.0

    @property
    def key(self) -> str:
        return "|".join(
            (normalize_text(self.title), normalize_text(self.artist), normalize_text(self.album), str(int(self.duration)))
        )

    @property
    def playing(self) -> bool:
        return self.status == "Playing"

    def current_position(self) -> float:
        pos = self.position
        if self.playing and self.stamp:
            pos += time.monotonic() - self.stamp
        if self.duration > 0:
            pos = min(pos, self.duration)
        return max(0.0, pos)


class PlayerWatcher:
    FORMAT = (
        "{{playerName}}\t{{playerInstance}}\t{{status}}\t{{title}}\t"
        "{{artist}}\t{{album}}\t{{mpris:length}}\t{{position}}"
    )

    def __init__(self, preferred: str = ""):
        self.preferred = preferred
        self.track = Track()
        self.previous: Track | None = None
        self._selected = ""
        self._last_poll = 0.0

    @staticmethod
    def _run(args, timeout=2.0):
        try:
            return subprocess.run(
                args,
                capture_output=True,
                text=True,
                timeout=timeout,
                check=False,
            )
        except (OSError, subprocess.SubprocessError):
            return None

    def _candidates(self):
        result = self._run(["playerctl", "-a", "metadata", "--format", self.FORMAT])
        if result is None or not result.stdout.strip():
            return []
        candidates = []
        for raw in result.stdout.splitlines():
            parts = raw.split("\t")
            if len(parts) < 8:
                continue
            name, instance, status, title, artist, album, length, position = parts[:8]
            title = normalize_text(title)
            artist = normalize_text(artist)
            if not title and not artist:
                continue
            try:
                duration = float(length) / 1_000_000.0
            except ValueError:
                duration = 0.0
            try:
                pos = float(position) / 1_000_000.0
            except ValueError:
                pos = 0.0
            rank = 2 if status == "Playing" else 1 if status == "Paused" else 0
            preferred = instance if instance else name
            match = 1 if preferred == self.preferred or name == self.preferred else 0
            candidates.append(
                (
                    rank,
                    match,
                    1 if preferred == self._selected else 0,
                    Track(title, artist, normalize_text(album), duration, preferred, status),
                    pos,
                )
            )
        candidates.sort(key=lambda item: (-item[0], -item[1], -item[2], item[3].key))
        return candidates

    def poll(self, force: bool = False) -> Track | None:
        now = time.monotonic()
        if not force and now - self._last_poll < 0.35:
            return None
        self._last_poll = now

        candidates = self._candidates()
        if not candidates:
            self._selected = ""
            if self.track.title or self.track.artist:
                self.previous, self.track = self.track, Track()
                return self.track
            return None

        _, _, _, fresh, measured = candidates[0]
        self._selected = fresh.player
        old = self.track
        changed = (
            fresh.key != old.key
            or fresh.status != old.status
            or fresh.player != old.player
        )
        fresh.stamp = now
        # El metadata de MPRIS se actualiza a saltos; conservamos la
        # extrapolación si la diferencia es pequeña para no vibrar.
        if changed:
            fresh.position = measured
        else:
            estimate = old.current_position()
            if abs(estimate - measured) > 0.75:
                fresh.position = measured
            else:
                fresh.position = old.position
                fresh.stamp = old.stamp
        self.previous, self.track = old, fresh
        return fresh


# --------------------------------------------------------------------------
# letras
# --------------------------------------------------------------------------

# Los minutos admiten tres digitos ([100:00] son 100 minutos): con dos, una
# letra larga se descartaba entera. Las horas se distinguen por el segundo
# grupo de dos puntos ([01:02:03] es una hora, dos minutos y tres segundos).
LRC_TAG = re.compile(r"\[(?:(\d{1,3}):)?(\d{1,3}):(\d{1,2})(?:[.:](\d{1,6}))?\]")
LRC_OFFSET = re.compile(r"\[offset:([+-]?\d+)\]", re.I)
# Solo las etiquetas de tiempo mejoradas (<00:12.34>): un patron generico
# <[^>]*> se comia texto normal entre angulos, como "I <3 you > me".
ENHANCED_TAG = re.compile(r"<(\d{1,3}):(\d{1,2})(?:[.:](\d{1,6}))?>")


class LyricLine:
    __slots__ = ("start", "duration", "text", "chars")

    def __init__(self, start: float, duration: float, text: str, chars=None):
        self.start = float(start)
        if self.start < 0:
            self.start = -1.0
        self.duration = max(0.0, float(duration or 0))
        self.text = normalize_text(text)
        self.chars = chars or []

    def as_json(self):
        out = [round(self.start, 3), round(self.duration, 3), self.text]
        if self.chars:
            out.append([round(value, 3) for value in self.chars])
        return out

    @classmethod
    def from_json(cls, value):
        if not isinstance(value, list) or len(value) < 3:
            return None
        chars = value[3] if len(value) > 3 and isinstance(value[3], list) else []
        text = normalize_text(str(value[2]))
        if not text:
            return None
        return cls(float(value[0]), float(value[1]), text, chars)


def lines_have_chars(lines):
    """True si la mayoría del texto trae tiempos por carácter utilizables.

    Es la diferencia entre un karaoke que sigue la voz y uno que reparte la
    duración de la línea a partes iguales. Los adaptadores dan `chars` con
    un tiempo por carácter; LRCLIB suele dar solo el tiempo de la línea.
    """
    con_texto = [line for line in lines or [] if line.text]
    if not con_texto:
        return False
    listas = sum(
        1
        for line in con_texto
        if line.chars and len(line.chars) >= len(line.text)
    )
    return listas * 2 >= len(con_texto)


def enhanced_pieces(text: str):
    """Trocea una línea LRC mejorada en (instante o None, texto).

    Las marcas `<mm:ss.xx>` dan el instante de la palabra que sigue. El
    texto anterior a la primera marca no tiene instante propio: hereda el
    de la línea.
    """
    matches = list(ENHANCED_TAG.finditer(text or ""))
    if not matches:
        return []
    pieces = []
    head = text[: matches[0].start()]
    if normalize_text(head):
        pieces.append((None, head))
    for index, match in enumerate(matches):
        seconds = int(match.group(1)) * 60 + int(match.group(2))
        fraction = match.group(3) or "0"
        seconds += int(fraction) / (10 ** len(fraction))
        end = matches[index + 1].start() if index + 1 < len(matches) else len(text)
        pieces.append((seconds, text[match.end():end]))
    return pieces


def enhanced_chars(text: str, pieces, start: float, end: float, offset: float):
    """Tiempos por carácter de una línea LRC mejorada.

    Cada palabra se reparte entre su marca y la siguiente: sus caracteres
    entran uno a uno, no todos de golpe. El espacio entre palabras entra
    con la palabra siguiente, así que el relleno no se detiene en él.
    """
    words = []
    for seconds, piece in pieces or []:
        clean = normalize_text(piece)
        if not clean:
            continue
        when = start if seconds is None else max(start, seconds + offset)
        words.append((when, clean))
    if not words:
        return []
    if " ".join(piece for _, piece in words) != text:
        # La normalización de los trozos no reconstruye el texto completo:
        # mejor no inventar tiempos y dejar el karaoke de nivel de línea.
        return []
    chars = []
    for index, (when, piece) in enumerate(words):
        if chars and when < chars[-1]:
            # Dos palabras con la misma marca: el relleno no puede
            # retroceder.
            when = chars[-1]
        if index + 1 < len(words):
            until = words[index + 1][0]
        else:
            # La última palabra no se estira por un silencio largo: si no,
            # el relleno se queda arrastrándose hasta la línea siguiente.
            until = min(end, when + max(0.45, 0.35 * len(piece)))
        if until <= when:
            until = when + 0.001
        step = (until - when) / max(1, len(piece))
        chars.extend(when + step * position for position in range(len(piece)))
        if index + 1 < len(words):
            chars.append(words[index + 1][0])
    if len(chars) != len(text):
        return []
    return chars


def parse_lrc(text: str):
    text = (text or "").replace("\r\n", "\n").replace("\r", "\n")
    offset = 0.0
    match = LRC_OFFSET.search(text)
    if match:
        try:
            offset = int(match.group(1)) / 1000.0
        except ValueError:
            offset = 0.0

    found = {}
    for raw in text.splitlines():
        raw = raw.strip()
        if not raw:
            continue
        tags = list(LRC_TAG.finditer(raw))
        if not tags:
            continue
        stripped = LRC_TAG.sub("", raw)
        body = ENHANCED_TAG.sub("", stripped).strip()
        if not body:
            continue
        if re.match(r"^(ar|al|ti|by|re|ve|length|offset):", body, re.I):
            continue
        pieces = enhanced_pieces(stripped)
        for tag in tags:
            hours = int(tag.group(1) or 0)
            minutes = int(tag.group(2))
            seconds = float(tag.group(3))
            fraction = tag.group(4) or "0"
            # Hasta seis decimales: algunos LRC traen microsegundos.
            fraction_value = int(fraction) / (10 ** len(fraction))
            start = hours * 3600 + minutes * 60 + seconds + fraction_value + offset
            if start < 0:
                continue
            found[round(start, 3)] = (body, pieces)

    lines = []
    times = sorted(found)
    for index, start in enumerate(times):
        body, pieces = found[start]
        end = times[index + 1] if index + 1 < len(times) else start + 6.0
        duration = clamp(end - start, 0.0, 10.0)
        chars = enhanced_chars(normalize_text(body), pieces, start, end, offset)
        lines.append(LyricLine(start, duration, body, chars))
    return lines


CREDIT_RE = re.compile(
    r"^(lyrics?\s+by|composed\s+by|written\s+by|produced\s+by|arranged\s+by|"
    r"lyricist|composer|arranger|作词|作曲|编曲|制作人)\s*[:：]",
    re.I,
)


def clean_lyric_lines(lines):
    result = []
    for line in lines or []:
        if not line.text or CREDIT_RE.match(line.text):
            continue
        if (
            result
            and line.text == result[-1].text
            and abs(line.start - result[-1].start) < 0.35
        ):
            continue
        result.append(line)
    return result


def plain_lines(text: str, duration: float):
    raw = [
        normalize_text(line)
        for line in (text or "").splitlines()
        if normalize_text(line)
    ]
    if not raw:
        return []
    if duration > 20:
        start = min(6.0, duration * 0.05)
        end = max(start + 1, duration - 4.0)
        step = (end - start) / max(1, len(raw))
    else:
        start = 1.0
        step = 4.0
    lines = []
    for index, value in enumerate(raw):
        lines.append(LyricLine(start + index * step, step * 0.92, value))
    return lines


def _normalize_match(value: str) -> str:
    value = unicodedata.normalize("NFKD", value or "")
    value = "".join(ch for ch in value if not unicodedata.combining(ch))
    return "".join(ch.lower() for ch in value if ch.isalnum())


def _http_json(url: str, headers=None, timeout=12.0):
    request = urllib.request.Request(
        url,
        headers={
            "User-Agent": f"{APP}/{VERSION}",
            "Accept": "application/json",
            **(headers or {}),
        },
    )
    with urllib.request.urlopen(request, timeout=timeout) as response:
        payload = response.read().decode("utf-8", "replace")
    return json.loads(payload)


def fetch_lrclib(track: Track, log):
    params = {
        "track_name": track.title,
        "artist_name": track.artist,
    }
    if track.album:
        params["album_name"] = track.album
    url = "https://lrclib.net/api/search?" + urllib.parse.urlencode(params)
    try:
        data = _http_json(url, timeout=3.0)
    except urllib.error.HTTPError as error:
        log(f"lrclib HTTP {error.code}")
        return [], f"http {error.code}"
    except Exception as error:  # noqa: BLE001
        log(f"lrclib error: {error!r}")
        return [], "red"
    if not isinstance(data, list) or not data:
        log("lrclib sin resultados")
        return [], None

    wanted_title = _normalize_match(track.title)
    wanted_artist = _normalize_match(track.artist)
    best = None
    best_score = -1.0
    for candidate in data:
        if not isinstance(candidate, dict):
            continue
        ctitle = _normalize_match(candidate.get("trackName", ""))
        cartist = _normalize_match(candidate.get("artistName", ""))
        synced_lyrics = candidate.get("syncedLyrics") or ""
        synced = bool(synced_lyrics)
        # Un LRC mejorado trae tiempos por palabra: es la versión que hace
        # que el karaoke siga la voz, así que gana a la de nivel de línea
        # cuando las dos encajan igual de bien.
        mejorada = bool(ENHANCED_TAG.search(synced_lyrics))
        score = 0.0
        if ctitle == wanted_title:
            score += 5.0
        elif ctitle and (ctitle in wanted_title or wanted_title in ctitle):
            score += 2.5
        if wanted_artist and cartist:
            if cartist == wanted_artist:
                score += 4.0
            elif wanted_artist in cartist or cartist in wanted_artist:
                score += 2.0
            else:
                # artistas separados por comas: basta con uno en común
                wanted_parts = {part.strip() for part in track.artist.split(",") if part.strip()}
                if any(_normalize_match(part) in cartist for part in wanted_parts):
                    score += 1.5
        if synced:
            score += 3.0
        if mejorada:
            score += 1.0
        try:
            cduration = float(candidate.get("duration") or 0)
            if track.duration > 0 and cduration > 0:
                score += max(0.0, 2.0 - abs(cduration - track.duration) / 20.0)
        except (TypeError, ValueError):
            pass
        if score > best_score:
            best_score = score
            best = candidate

    if best is None:
        return [], None
    lrc = best.get("syncedLyrics") or ""
    if lrc:
        lines = parse_lrc(lrc)
        if lines:
            log(f"lrclib: {best.get('trackName')} / {best.get('artistName')} (sync)")
            return lines, None
    plain = best.get("plainLyrics") or ""
    if plain:
        lines = plain_lines(plain, track.duration)
        if lines:
            log(f"lrclib: {best.get('trackName')} / {best.get('artistName')} (plain)")
            return lines, None
    return [], None


def fetch_netease(track: Track, log):
    query = f"{track.title} {track.artist}".strip()
    if not query:
        return []
    search_url = "https://music.163.com/api/search/get?" + urllib.parse.urlencode(
        {"type": 1, "s": query, "limit": 5}
    )
    try:
        data = _http_json(search_url, headers={"Referer": "https://music.163.com"}, timeout=10.0)
    except Exception as error:  # noqa: BLE001
        log(f"netease búsqueda: {error!r}")
        return [], "red"
    songs = (((data or {}).get("result") or {}).get("songs") or []) if isinstance(data, dict) else []
    if not songs:
        log("netease sin resultados")
        return [], None

    wanted_title = _normalize_match(track.title)
    wanted_artist = _normalize_match(track.artist)
    chosen = None
    best_score = -1.0
    for song in songs:
        if not isinstance(song, dict):
            continue
        title = _normalize_match(song.get("name", ""))
        artists = " ".join(
            _normalize_match(artist.get("name", ""))
            for artist in (song.get("artists") or [])
            if isinstance(artist, dict)
        )
        score = 0.0
        if title == wanted_title:
            score += 4.0
        elif title and (title in wanted_title or wanted_title in title):
            score += 2.0
        if wanted_artist and artists and (wanted_artist in artists or artists in wanted_artist):
            score += 3.0
        if score > best_score:
            best_score = score
            chosen = song
    if not chosen:
        return [], None
    song_id = str(chosen.get("id") or "")
    if not song_id.isdigit():
        return [], None
    lyric_url = "https://music.163.com/api/song/lyric?" + urllib.parse.urlencode(
        {"id": song_id, "lv": 1, "kv": 1, "tv": -1}
    )
    try:
        data = _http_json(lyric_url, headers={"Referer": "https://music.163.com"}, timeout=10.0)
    except Exception as error:  # noqa: BLE001
        log(f"netease letra: {error!r}")
        return [], "red"
    lrc = (((data or {}).get("lrc") or {}).get("lyric") or "") if isinstance(data, dict) else ""
    lines = parse_lrc(lrc)
    if lines:
        log(f"netease: {chosen.get('name')} (sync)")
        return lines, None
    # Algunas canciones solo traen la letra "traducida" o texto plano.
    text = ENHANCED_TAG.sub("", lrc).strip()
    if text:
        lines = plain_lines(text, track.duration)
        if lines:
            log(f"netease: {chosen.get('name')} (plain)")
            return lines, None
    return [], None


def find_lyric_adapter():
    roots = [
        os.path.join(state_dir(), "plugins", "materialized"),
        os.path.expanduser("~/.local/share/noctalia/plugins"),
    ]
    for root in roots:
        if not os.path.isdir(root):
            continue
        for current, dirs, files in os.walk(root):
            if "lyric_sources.py" in files and "music_sources.py" in files:
                return os.path.join(current, "lyric_sources.py")
    return ""


def fetch_adapter(track: Track, log):
    script = find_lyric_adapter()
    if not script:
        return [], None
    workdir = os.path.dirname(script)
    sources = ("splayer", "qqmusic", "kugou")
    failed = False
    for source in sources:
        request = {
            "source": source,
            "track": {
                "title": track.title,
                "artist": track.artist,
                "album": track.album,
                "duration": int(track.duration * 1_000_000),
            },
            "options": {},
        }
        path = ""
        try:
            fd, path = tempfile.mkstemp(prefix="lyrics-", suffix=".json", dir=CACHE_DIR)
            with os.fdopen(fd, "w", encoding="utf-8") as handle:
                json.dump(request, handle)
            result = subprocess.run(
                [sys.executable, script, path],
                cwd=workdir,
                capture_output=True,
                text=True,
                timeout=22,
                check=False,
            )
            if not result.stdout.strip():
                log(f"{source}: sin salida")
                failed = True
                continue
            data = json.loads(result.stdout)
            raw = data.get("lines") if isinstance(data, dict) else None
            if not raw:
                diag = data.get("diag") if isinstance(data, dict) else None
                log(f"{source}: {diag}")
                continue
            lines = []
            for item in raw:
                if not isinstance(item, dict):
                    continue
                text = normalize_text(item.get("text", ""))
                if not text and item.get("translation"):
                    text = normalize_text(item.get("translation", ""))
                if not text:
                    continue
                start = float(item.get("time", -1))
                duration = float(item.get("duration", 0))
                if start > 10_000:
                    start /= 1000.0
                    duration /= 1000.0
                elif start < 0:
                    continue
                chars = item.get("chars") or []
                if chars and isinstance(chars, list):
                    chars = [float(value) / 1000.0 for value in chars]
                lines.append(LyricLine(start, duration, text, chars))
            if lines:
                log(f"{source}: {len(lines)} líneas")
                return lines, None
        except subprocess.TimeoutExpired:
            log(f"{source}: timeout")
            failed = True
        except Exception as error:  # noqa: BLE001
            log(f"{source}: {error!r}")
            failed = True
        finally:
            if path and os.path.exists(path):
                try:
                    os.remove(path)
                except OSError:
                    pass
    return [], ("red" if failed else None)


def load_lyrics_settings():
    """Lee los ajustes del plugin Lyrics de Noctalia si están disponibles."""
    result = {
        "sources": ["lrclib", "netease", "splayer", "qqmusic", "kugou"],
        "credentials": {},
        "translation": "zh-Hans",
    }
    # El estado puede estar movido con NOCTALIA_STATE_HOME o XDG_STATE_HOME:
    # una ruta fija leeria los ajustes de otra instalacion.
    path = os.path.join(state_dir(), "settings.toml")
    if not os.path.isfile(path) or tomllib is None:
        return result
    try:
        with open(path, "rb") as handle:
            data = tomllib.load(handle)
    except Exception:  # noqa: BLE001
        return result
    section = (data.get("plugin_settings") or {}).get('h465855hgg/lyrics') or {}
    sources = section.get("lyrics_sources")
    if isinstance(sources, list) and sources:
        result["sources"] = [str(item).strip().lower() for item in sources if str(item).strip()]
    result["translation"] = str(section.get("translation_language") or result["translation"])
    for key in (
        "spotify_sp_dc", "spotify_access_token", "apple_developer_token",
        "apple_user_token", "apple_storefront", "musixmatch_token",
        "qishui_token", "qishui_api_url", "splayer_api_url",
    ):
        value = section.get(key)
        if value is not None:
            result["credentials"][key] = str(value)
    return result


def adapter_track(track: Track, art_url: str = ""):
    # No se envía la duración: NetEase la usa para filtrar y si no
    # coincide exactamente (tolerancia ~24 s) descarta la canción. Con
    # 0 = "desconocida" el matching es solo por título/artista, que
    # ya acierta (Lovesong / Adele se encuentra al instante).
    return {
        "title": track.title,
        "artist": track.artist,
        "album": track.album,
        "duration": 0,
        "artUrl": art_url,
    }


def adapter_request(source: str, track: Track, settings: dict):
    creds = dict(settings.get("credentials", {}))
    if source == "splayer":
        creds.setdefault(
            "splayer_api_url",
            settings.get("credentials", {}).get("splayer_api_url", "http://127.0.0.1:25884"),
        )
    request = {
        "source": source,
        "track": adapter_track(track),
        "credentials": creds,
        "options": {"translation_language": settings.get("translation", "zh-Hans")},
    }
    return request


def run_adapter(source: str, track: Track, settings: dict, log):
    script = find_lyric_adapter()
    if not script:
        return [], None
    workdir = os.path.dirname(script)
    request = adapter_request(source, track, settings)
    path = ""
    try:
        fd, path = tempfile.mkstemp(prefix="lyrics-", suffix=".json", dir=CACHE_DIR)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(request, handle)
        result = subprocess.run(
            [sys.executable, script, path],
            cwd=workdir,
            capture_output=True,
            text=True,
            # NetEase y QQ Music pueden tardar mas de 3 s: matarlos dejaba
            # sin letra canciones que el adaptador si sabia resolver.
            timeout=22,
            check=False,
        )
        if not result.stdout.strip():
            log(f"{source}: sin salida")
            return [], "red"
        data = json.loads(result.stdout)
        if not isinstance(data, dict):
            return [], None
        raw = data.get("lines")
        if not raw:
            diag = data.get("diag") if isinstance(data.get("diag"), list) else []
            log(f"{source}: {diag}")
            return [], None
        lines = []
        for item in raw:
            if not isinstance(item, dict):
                continue
            text = normalize_text(item.get("text", ""))
            if not text and item.get("translation"):
                text = normalize_text(item.get("translation", ""))
            if not text:
                continue
            start = float(item.get("time", -1))
            duration = float(item.get("duration", 0))
            # El adaptador siempre devuelve milisegundos (-1 = sin tiempo).
            if start < 0:
                start = -1.0
            else:
                start /= 1000.0
            if duration > 0:
                duration /= 1000.0
            chars = item.get("chars") or []
            if chars and isinstance(chars, list):
                chars = [float(value) / 1000.0 for value in chars]
            lines.append(LyricLine(start, duration, text, chars))
        if lines:
            log(f"{source}: {len(lines)} líneas")
            return lines, None
        return [], None
    except subprocess.TimeoutExpired:
        log(f"{source}: timeout")
        return [], "red"
    except Exception as error:  # noqa: BLE001
        log(f"{source}: {error!r}")
        return [], "red"
    finally:
        if path and os.path.exists(path):
            try:
                os.remove(path)
            except OSError:
                pass

def cache_key(track: Track) -> str:
    raw = "\n".join(
        (
            normalize_text(track.title).casefold(),
            normalize_text(track.artist).casefold(),
            normalize_text(track.album).casefold(),
            str(int(track.duration)),
        )
    )
    return hashlib.sha1(raw.encode("utf-8")).hexdigest()[:24]


def load_cache(track: Track):
    os.makedirs(CACHE_DIR, exist_ok=True)
    path = os.path.join(CACHE_DIR, cache_key(track) + ".json")
    if not os.path.isfile(path):
        return None
    try:
        with open(path, encoding="utf-8") as handle:
            data = json.load(handle)
        if not isinstance(data, dict):
            return None
        lines = [LyricLine.from_json(value) for value in data.get("lines", [])]
        lines = [line for line in lines if line and line.text]
        if lines:
            return lines, data.get("source", "cache"), bool(data.get("synced", True))
    except (OSError, ValueError):
        pass
    return None


def save_cache(track: Track, lines, source: str, synced: bool):
    os.makedirs(CACHE_DIR, exist_ok=True)
    path = os.path.join(CACHE_DIR, cache_key(track) + ".json")
    payload = {
        "title": track.title,
        "artist": track.artist,
        "album": track.album,
        "duration": round(track.duration, 2),
        "source": source,
        "synced": bool(synced),
        "saved": int(time.time()),
        "lines": [line.as_json() for line in lines],
    }
    try:
        with open(path, "w", encoding="utf-8") as handle:
            json.dump(payload, handle, ensure_ascii=False, separators=(",", ":"))
    except OSError:
        pass


def mark_missing(track: Track):
    os.makedirs(CACHE_DIR, exist_ok=True)
    path = os.path.join(CACHE_DIR, cache_key(track) + ".none")
    try:
        with open(path, "w", encoding="utf-8") as handle:
            handle.write(str(int(time.time())))
    except OSError:
        pass


def missing_recent(track: Track, hours=0.4) -> bool:
    path = os.path.join(CACHE_DIR, cache_key(track) + ".none")
    try:
        if not os.path.isfile(path):
            return False
        with open(path, encoding="utf-8") as handle:
            saved = int(handle.read().strip() or 0)
        return time.time() - saved < hours * 3600
    except (OSError, ValueError):
        return False


def word_checked_recent(track: Track, hours=WORD_CHECK_HOURS) -> bool:
    """True si ya se buscó una versión por palabra hace poco.

    Sin esta marca, cada reproducción de una canción cuya letra solo tiene
    tiempos de línea volvería a lanzar la búsqueda en segundo plano.
    """
    path = os.path.join(CACHE_DIR, cache_key(track) + ".noword")
    try:
        if not os.path.isfile(path):
            return False
        with open(path, encoding="utf-8") as handle:
            saved = int(handle.read().strip() or 0)
        return time.time() - saved < hours * 3600
    except (OSError, ValueError):
        return False


def mark_word_checked(track: Track):
    path = os.path.join(CACHE_DIR, cache_key(track) + ".noword")
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        with open(path, "w", encoding="utf-8") as handle:
            handle.write(str(int(time.time())))
    except OSError:
        pass


def estimate_times(lines, duration: float):
    """Asigna tiempos estimados solo a las líneas sin marca temporal.

    Una letra puede traer unas líneas con tiempo (LRC a medias) y otras sin
    él: pisar las que ya lo tienen descoloca el resaltado y la letra deja de
    seguir la canción.

    Las líneas sin tiempo se reparten por el hueco que les toca según su
    posición en la lista: entre dos líneas con tiempo se quedan en medio,
    detrás de la última si van al final y antes de la primera si van al
    principio. Repartirlas todas desde el principio (como se hacía) deja que
    una línea del final de la lista empiece a sonar en el segundo 6, por
    delante de la parte que sí tiene tiempos.

    Si la duración se conoce, todas las estimaciones se recortan a ella:
    una línea fuera de la canción nunca llega a resaltarse. Con una lista
    desordenada (la siguiente ancla es anterior a la anterior) no existe
    un intervalo válido: la estimación se queda detrás de la anterior en
    la lista, que es la que la precede en pantalla. Y si dos anclas
    tienen el mismo tiempo tampoco hay hueco: la estimada se queda en ese
    instante, porque detrás de la línea siguiente el resaltado volvería
    hacia atrás (la línea que va después ya se habría cantado).
    """
    sin_tiempo = [
        (index, line)
        for index, line in enumerate(lines)
        if line.text and line.start < 0
    ]
    if not sin_tiempo:
        return lines

    # Hueco por defecto entre líneas: cuatro segundos.
    #
    # No se deriva de la duración: con una canción de 200 s y una línea
    # sin tiempo al final, un hueco de 196 s la colocaba en el segundo 226
    # (fuera de la canción, así que nunca se resaltaba). El hueco es fijo
    # y el reparto se recorta al final, donde haga falta.
    hueco = 4.0

    # Anclas: las líneas con tiempo real y su posición en la lista.
    anclas = [
        (index, line.start)
        for index, line in enumerate(lines)
        if line.start >= 0
    ]

    # Cada línea sin tiempo se asigna al hueco que la rodea (la anterior con
    # tiempo y la siguiente con tiempo).
    grupos = []
    for indice, linea in sin_tiempo:
        antes = None
        despues = None
        for pos, inicio in anclas:
            if pos < indice and (antes is None or pos > antes[0]):
                antes = (pos, inicio)
            if pos > indice and (despues is None or pos < despues[0]):
                despues = (pos, inicio)
        for grupo in grupos:
            if grupo["antes"] == antes and grupo["despues"] == despues:
                grupo["lineas"].append(linea)
                break
        else:
            grupos.append(
                {"antes": antes, "despues": despues, "lineas": [linea]}
            )

    # Si la duración se conoce, ninguna estimación puede caer fuera de la
    # canción: el último instante útil es el final.
    limite = duration if duration and duration > 0 else None

    for grupo in grupos:
        miembros = grupo["lineas"]
        antes = grupo["antes"]
        despues = grupo["despues"]
        total = len(miembros)
        if antes and despues:
            # Entre dos líneas con tiempo: se reparten el hueco intermedio.
            # La siguiente puede estar más allá del final (un LRC con
            # tiempos rotos): el hueco se recorta a la duración.
            span = despues[1] - antes[1]
            if span > 0 and limite is not None:
                span = min(span, limite - antes[1])
            if span > 0:
                paso = span / (total + 1)
            elif despues[1] < antes[1]:
                # Lista desordenada: la siguiente ancla es anterior a la
                # anterior. Se usa el hueco fijo detrás de la anterior,
                # recortado a lo que quede de canción.
                paso = hueco
                if limite is not None:
                    paso = (
                        min(hueco, (limite - antes[1]) / (total + 1))
                        if limite > antes[1]
                        else 0.0
                    )
            else:
                # La siguiente ancla tiene el mismo tiempo que la anterior
                # (o cae al final de la canción): no hay hueco entre las
                # dos. Poner la estimada detrás la dejaria despues de la
                # linea siguiente de la lista, y el resaltado volveria
                # hacia atras.
                paso = 0.0
            for indice, linea in enumerate(miembros):
                if paso > 0:
                    linea.start = antes[1] + (indice + 1) * paso
                else:
                    linea.start = (
                        min(antes[1], limite)
                        if limite is not None
                        else antes[1]
                    )
                if linea.start < 0:
                    linea.start = 0.0
                if linea.duration <= 0:
                    linea.duration = max(0.1, paso * 0.92) if paso > 0 else 0.1
        elif antes:
            # Detrás de la última línea con tiempo. Si la canción se sabe
            # y no caben todas las líneas antes de que termine, el paso se
            # recorta: una línea fuera de la canción nunca se resaltaba.
            if limite is None:
                paso = hueco
            elif limite > antes[1]:
                paso = min(hueco, (limite - antes[1]) / (total + 1))
            else:
                # La última real ya está en el final (o más allá): no queda
                # sitio detrás sin salirse de la canción.
                paso = 0.0
            for indice, linea in enumerate(miembros):
                if paso > 0:
                    linea.start = antes[1] + (indice + 1) * paso
                else:
                    linea.start = (
                        min(antes[1], limite)
                        if limite is not None
                        else antes[1]
                    )
                if linea.start < 0:
                    linea.start = 0.0
                if linea.duration <= 0:
                    linea.duration = max(0.1, paso * 0.92) if paso > 0 else 0.1
        elif despues:
            # Antes de la primera línea con tiempo. Se reparte hacia atrás
            # sin salirse del origen ni de la canción: si no, varias
            # líneas sin tiempo delante de una real muy temprana acaban
            # todas en el segundo 0 y se resaltan a la vez.
            fin = despues[1]
            if limite is not None:
                fin = min(fin, limite)
            inicio = max(0.0, fin - total * hueco)
            paso = (fin - inicio) / (total + 1)
            if paso <= 0:
                # La línea real llega en el segundo 0 (o la canción es tan
                # corta que no hay hueco): se quedan en el origen.
                paso = 0.0
            for indice, linea in enumerate(miembros):
                linea.start = inicio + indice * paso
                if linea.duration <= 0:
                    linea.duration = max(0.1, paso * 0.92) if paso > 0 else 0.1
        else:
            # Ninguna línea tiene tiempo: se reparte desde el principio y,
            # si la duración se conoce, sin pasarse del final.
            if limite is not None and limite > 20:
                inicio = min(6.0, limite * 0.05)
                fin = max(inicio + 1, limite - 4.0)
                paso = (fin - inicio) / max(1, total)
            elif limite is not None:
                inicio = min(1.0, limite * 0.1)
                paso = (limite - inicio) / (total + 1)
                if paso <= 0:
                    paso = 0.0
            else:
                inicio = 1.0
                paso = 4.0
            for indice, linea in enumerate(miembros):
                linea.start = inicio + indice * paso
                if limite is not None:
                    linea.start = min(linea.start, limite)
                if linea.duration <= 0:
                    linea.duration = max(0.1, paso * 0.92) if paso > 0 else 0.1
    return lines


def fetch_lyrics(
    track: Track,
    force: bool,
    log,
    on_update=None,
    cancelled=None,
    upgrade: bool = False,
):
    if not force:
        cached = load_cache(track)
        if cached:
            lines, source, synced = cached
            log(f"cache: {len(lines)} líneas ({source})")
            return lines, source, synced
        if missing_recent(track):
            log("sin letra (caché negativa)")
            return [], "cache", False

    settings = load_lyrics_settings()
    sources = list(settings.get("sources") or ["lrclib", "netease"])
    # Filtra las fuentes que necesitan credenciales ausentes.
    available = []
    for source in sources:
        source = source.strip().lower()
        if source in ("spotify",) and not (
            settings.get("credentials", {}).get("spotify_sp_dc")
            or settings.get("credentials", {}).get("spotify_access_token")
        ):
            continue
        if source in ("apple_music",) and not (
            settings.get("credentials", {}).get("apple_developer_token")
            or settings.get("credentials", {}).get("apple_user_token")
        ):
            continue
        if source in ("musixmatch",) and not settings.get("credentials", {}).get("musixmatch_token"):
            continue
        if source in ("qishui",) and not settings.get("credentials", {}).get("qishui_api_url"):
            continue
        if source not in available:
            available.append(source)

    # Trabajadores en paralelo: la primera letra se publica en cuanto
    # llega, para no hacer esperar. Si otra fuente trae tiempos por
    # palabra, la mejora en cuanto aparece y es la que se queda en caché.
    result = {"lines": None, "source": "", "synced": False, "word": False}
    result_lock = threading.Lock()

    def publish(lines, source):
        lines = clean_lyric_lines(lines)
        if not lines:
            return False
        lines = estimate_times(lines, track.duration)
        synced = len(lines) > 1 and any(line.start >= 0 for line in lines)
        word = lines_have_chars(lines)
        aviso = None
        with result_lock:
            actual_palabra = result["word"]
            if result["lines"] is not None and not (
                word and not actual_palabra
            ):
                # La primera letra ya está y esta no la mejora: no se pisa
                # lo que el usuario está viendo ni la caché buena.
                return False
            result["lines"] = lines
            result["source"] = source
            result["synced"] = synced
            result["word"] = word
            # Solo el ganador escribe la cache: si escribieran todos, el
            # ultimo en llegar podia dejar la letra perdedora. Una mejora
            # sin tiempos por palabra no reescribe una caché válida.
            if word or not upgrade:
                try:
                    save_cache(track, lines, source, synced)
                except Exception:  # noqa: BLE001
                    pass
            aviso = (lines, source, synced)
        if on_update is not None:
            try:
                on_update(*aviso)
            except Exception:  # noqa: BLE001
                pass
        return True

    def worker_builtin_lrclib():
        for attempt in (0, 1):
            try:
                lines, error = fetch_lrclib(track, log)
            except Exception as exc:  # noqa: BLE001
                log(f"lrclib: excepción {exc!r}")
                return
            if lines:
                publish(lines, "lrclib")
                return
            if error is None:
                return
            if attempt == 0:
                time.sleep(1.0)

    def worker_adapter(source):
        try:
            lines, error = run_adapter(source, track, settings, log)
            if lines:
                publish(lines, source)
        except Exception as exc:  # noqa: BLE001
            log(f"{source}: excepción {exc!r}")

    threads = []
    for source in available:
        if source == "lrclib":
            t = threading.Thread(target=worker_builtin_lrclib, daemon=True)
        else:
            t = threading.Thread(target=worker_adapter, args=(source,), daemon=True)
        threads.append(t)

    if not threads:
        if not upgrade:
            mark_missing(track)
        return [], "", False

    for t in threads:
        t.start()

    # Espera a la primera letra; despues, un margen corto a que llegue una
    # versión con tiempos por palabra. El plazo general es largo porque
    # hay proveedores que tardan: con 4 s una letra que tarda 6 s se tiraba
    # a la basura y el usuario se quedaba sin letra pese a estar
    # disponible.
    deadline = time.monotonic() + SEARCH_TIMEOUT
    grace_deadline = None
    while True:
        with result_lock:
            lines_now = result["lines"]
            word_now = result["word"]
        if word_now:
            # Ya está lo mejor posible: no se espera al resto.
            break
        if cancelled is not None and cancelled():
            break
        now = time.monotonic()
        if lines_now is not None:
            if grace_deadline is None:
                grace_deadline = now + WORD_GRACE
            if now >= grace_deadline:
                break
        if now >= deadline:
            break
        if not any(t.is_alive() for t in threads):
            break
        time.sleep(0.05)

    # Cancelación best-effort: se dejan terminar los hilos (daemon).
    with result_lock:
        lines = result["lines"]
        source = result["source"]
        synced = result["synced"]

    if lines:
        return lines, source, synced
    if upgrade:
        # La caché que se está mostrando sigue siendo válida: no se toca.
        return [], "", False
    if any(t.is_alive() for t in threads):
        # Se agoto el plazo con proveedores todavia en marcha: la letra
        # puede llegar despues, asi que no se marca la cache negativa
        # (si se marcara, la busqueda se daria por cerrada y no se
        # volveria a mirar esa cancion).
        log("plazo de busqueda agotado: no se marca la caché negativa")
        return [], "", False
    mark_missing(track)
    return [], "", False


class Fetcher:
    def __init__(self, log):
        self.log = log
        self._lock = threading.Lock()
        self._request = None
        self._generation = 0
        self._result = None
        self._thread = threading.Thread(target=self._worker, daemon=True)
        self._thread.start()

    def start(self, track: Track, force: bool = False, upgrade: bool = False):
        with self._lock:
            self._generation += 1
            self._request = (track, force, upgrade, self._generation)
            self._result = None

    def take(self):
        with self._lock:
            result = self._result
            self._result = None
            return result

    def _worker(self):
        while True:
            with self._lock:
                request = self._request
                self._request = None
            if request is None:
                time.sleep(0.08)
                continue
            track, force, upgrade, generation = request
            entregado = [False]

            def on_update(lines, source, synced):
                with self._lock:
                    if generation != self._generation:
                        return
                    entregado[0] = True
                    self._result = (lines, source, synced)

            try:
                lines, source, synced = fetch_lyrics(
                    track,
                    force,
                    self.log,
                    on_update=on_update,
                    cancelled=lambda: self._generation != generation,
                    upgrade=upgrade,
                )
            except Exception as error:  # noqa: BLE001
                self.log(f"fetch: {error!r}")
                lines, source, synced = [], "", False
            with self._lock:
                # Lo ya entregado no se repite: volver a aplicarlo
                # recolocaría el carrusel a mitad de canción.
                if generation == self._generation and not entregado[0]:
                    self._result = (lines, source, synced)


# --------------------------------------------------------------------------
# render
# --------------------------------------------------------------------------

PLUGIN_ID = "faminec/lyrics-carousel"

# Segundos que dura el desplazamiento entre líneas cuando la transición
# suave está activa. Se recorta al 80 % del hueco si la siguiente línea
# llega antes, para que nunca se solapen dos movimientos.
GHOST_SECONDS = 0.9

DEFAULTS = {
    "font_family": "Departure Mono",
    "font_size": 22,
    "direction": "down",
    "marker": False,
    "karaoke": True,
    "footer": False,
    "hints": False,
    "header": False,
    "spacing": 2,
    "ghost": True,
    "offset_ms": 0,
    "width": 1200,
    "height": 820,
    "anchor": "center",
    "custom_x": 100,
    "custom_y": 100,
    "accent": "primary",
    "custom_color": "#e46767",
    "active_scale": 1.35,
    "visible_above": 6,
    "visible_below": 6,
}

BOOL_KEYS = ("marker", "karaoke", "footer", "hints", "header", "ghost")
INT_KEYS = (
    "font_size", "spacing", "offset_ms", "width", "height",
    "custom_x", "custom_y", "visible_above", "visible_below",
)
FLOAT_KEYS = ("active_scale",)


def read_overrides() -> dict:
    """Ajustes cambiados desde el panel (capa temporal, se vuelca al cerrar)."""
    try:
        with open(overrides_path(), encoding="utf-8") as handle:
            data = json.load(handle)
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def load_settings() -> dict:
    """Ajustes del plugin: valores por defecto + settings.toml + overrides."""
    cfg = dict(DEFAULTS)

    if os.path.isfile(settings_path()) and tomllib is not None:
        try:
            with open(settings_path(), "rb") as handle:
                data = tomllib.load(handle)
            section = (data.get("plugin_settings") or {}).get(PLUGIN_ID) or {}
            for key, value in section.items():
                if key in cfg and value is not None:
                    cfg[key] = value
        except Exception:  # noqa: BLE001
            pass

    # Los overrides del panel tienen prioridad: son cambios explicitos
    # todavia no volcados al settings.toml.
    for key, value in read_overrides().items():
        if key in cfg:
            cfg[key] = value

    for key in BOOL_KEYS:
        value = cfg[key]
        if isinstance(value, str):
            cfg[key] = value.strip().lower() in ("1", "true", "yes", "on")
        else:
            cfg[key] = bool(value)
    for key in INT_KEYS:
        try:
            cfg[key] = int(cfg[key])
        except (TypeError, ValueError):
            cfg[key] = DEFAULTS[key]
    for key in FLOAT_KEYS:
        try:
            cfg[key] = float(cfg[key])
        except (TypeError, ValueError):
            cfg[key] = DEFAULTS[key]
    cfg["font_size"] = max(6, min(96, cfg["font_size"]))
    cfg["spacing"] = max(1, min(6, cfg["spacing"]))
    # Los limites son los del panel (lib/settings.luau, LIMITS): el
    # manifiesto ya no los declara porque esos ajustes solo se cambian en el
    # panel. El script los recorta al leer, asi que un valor que llegue
    # fuera de rango (un IPC, un fichero editado a mano) no rompe nada.
    cfg["offset_ms"] = max(-3000, min(3000, cfg["offset_ms"]))
    cfg["width"] = max(400, min(3840, cfg["width"]))
    cfg["height"] = max(200, min(2160, cfg["height"]))
    cfg["visible_above"] = max(0, min(20, cfg["visible_above"]))
    cfg["visible_below"] = max(0, min(20, cfg["visible_below"]))
    try:
        cfg["custom_x"] = max(0, min(10000, int(cfg["custom_x"])))
    except (TypeError, ValueError):
        cfg["custom_x"] = 100
    try:
        cfg["custom_y"] = max(0, min(10000, int(cfg["custom_y"])))
    except (TypeError, ValueError):
        cfg["custom_y"] = 100
    cfg["active_scale"] = max(1.0, min(2.5, cfg["active_scale"]))
    if cfg["direction"] not in ("down", "up"):
        cfg["direction"] = "down"
    if cfg["accent"] not in ACCENT_NAMES:
        cfg["accent"] = DEFAULTS["accent"]
    cfg["font_family"] = str(cfg["font_family"] or DEFAULTS["font_family"])
    cfg["custom_color"] = str(cfg["custom_color"] or DEFAULTS["custom_color"])
    return cfg


ANCHOR_ALIASES = {
    "topleft": "top-left", "topcenter": "top-center", "topright": "top-right",
    "left": "left-center", "leftcenter": "left-center", "middle": "center",
    "centre": "center", "centro": "center", "medio": "center",
    "right": "right-center", "rightcenter": "right-center",
    "bottomleft": "bottom-left", "bottomcenter": "bottom-center",
    "bottomright": "bottom-right", "top": "top-center", "bottom": "bottom-center",
    "arriba": "top-center", "abajo": "bottom-center",
    "izquierda": "left-center", "derecha": "right-center",
}


def normalize_anchor(value) -> str:
    key = str(value or "").strip().lower()
    key = re.sub(r"[\s_]+", "-", key)
    key = re.sub(r"-+", "-", key).strip("-")
    if key in (
        "top-left", "top-center", "top-right", "left-center", "center",
        "right-center", "bottom-left", "bottom-center", "bottom-right",
        "custom",
    ):
        return key
    return ANCHOR_ALIASES.get(key, "center")


def focused_monitor():
    try:
        result = subprocess.run(
            ["hyprctl", "monitors", "-j"], capture_output=True, text=True, timeout=3
        )
        monitors = json.loads(result.stdout or "[]")
    except Exception:  # noqa: BLE001
        return None
    if not isinstance(monitors, list) or not monitors:
        return None
    for monitor in monitors:
        if isinstance(monitor, dict) and monitor.get("focused"):
            return monitor
    first = monitors[0]
    return first if isinstance(first, dict) else None


def apply_geometry(cfg):
    """Mueve y redimensiona la ventana en caliente (sin recrearla)."""
    monitor = focused_monitor()
    if monitor is None:
        return False
    try:
        screen_w = int(monitor.get("width") or 0)
        screen_h = int(monitor.get("height") or 0)
    except (TypeError, ValueError):
        return False
    if screen_w <= 0 or screen_h <= 0:
        return False
    # La ventana nunca puede ser mayor que el monitor (igual que el
    # panel): si no, Hyprland acepta una ventana de 3840x2160 en una
    # pantalla de 1920x1080 y la posición calculada sale negativa.
    try:
        width = int(cfg.get("width", DEFAULTS.get("width", 1200)))
    except (TypeError, ValueError):
        width = int(DEFAULTS.get("width", 1200))
    try:
        height = int(cfg.get("height", DEFAULTS.get("height", 820)))
    except (TypeError, ValueError):
        height = int(DEFAULTS.get("height", 820))
    width = max(1, min(width, screen_w))
    height = max(1, min(height, screen_h))
    anchor = normalize_anchor(cfg.get("anchor", "center"))
    margin = 16
    if anchor == "custom":
        try:
            x = int(cfg.get("custom_x", 100))
        except (TypeError, ValueError):
            x = 100
        try:
            y = int(cfg.get("custom_y", 100))
        except (TypeError, ValueError):
            y = 100
    else:
        if anchor in ("top-left", "left-center", "bottom-left"):
            x = margin
        elif anchor in ("top-right", "right-center", "bottom-right"):
            x = screen_w - width - margin
        else:
            x = (screen_w - width) // 2
        if anchor in ("top-left", "top-center", "top-right"):
            y = margin
        elif anchor in ("bottom-left", "bottom-center", "bottom-right"):
            y = screen_h - height - margin
        else:
            y = (screen_h - height) // 2
    window = "class:^noctalia-lyrics-carousel$"
    expressions = (
        f"hl.dsp.window.resize({{ x = {width}, y = {height}, window = \"{window}\" }})",
        f"hl.dsp.window.move({{ x = {x}, y = {y}, window = \"{window}\" }})",
    )
    ok = False
    for expression in expressions:
        try:
            result = subprocess.run(
                ["hyprctl", "dispatch", expression],
                capture_output=True,
                text=True,
                timeout=3,
            )
            ok = ok or result.returncode == 0
        except Exception:  # noqa: BLE001
            continue
    return ok


class LyricsCarousel:
    def __init__(self, args):
        self.args = args
        self.theme = Theme()
        self.fetcher = Fetcher(self.log)
        self.cfg = load_settings()
        if args.direction:
            self.cfg["direction"] = args.direction
        if args.no_karaoke:
            self.cfg["karaoke"] = False
        if args.active_scale:
            self.cfg["active_scale"] = args.active_scale
        if args.accent:
            self.cfg["accent"] = args.accent
        self._set_language(getattr(args, "lang", None) or "auto")
        self.direction = 1 if self.cfg["direction"] == "down" else -1
        self.karaoke = bool(self.cfg["karaoke"])
        self.spacing = int(self.cfg["spacing"])
        self.last_cfg = 0.0
        self.track = Track()
        self.lines: list[LyricLine] = []
        self.source = ""
        self.synced = False
        self.state = "idle"  # idle | loading | lyrics | empty
        self.track_key = ""
        self.started_at = time.monotonic()
        self.demo = args.demo
        self.width = 0
        self.height = 0
        self.scroll = 0.0
        self.scroll_from = 0.0
        self.scroll_to = 0.0
        self.scroll_started = 0.0
        self.scroll_duration = 0.0
        self.active_index = 0
        self.last_active = -1
        self.moving = False
        self.last_draw = 0.0
        self.last_reload = 0.0
        self.last_fetch = 0.0
        self.status_message = ""
        self.dirty = True
        self.stop_requested = False
        # SIGUSR1: el panel avisa de que la caché se ha vaciado y la
        # ventana abierta tiene que volver a buscar la canción actual.
        self.reload_requested = False
        self.last_counters = 0.0
        self._player = PlayerWatcher(args.player) if not self.demo else None
        self.image = None
        self.image_error = ""
        # El visualizador es siempre el fondo de la ventana: cava real y,
        # si no está o falla, barras simuladas. Nunca es una opción.
        self.visualizer = Visualizer(self.log) if Visualizer is not None else None
        # Si la terminal se cierra, las escrituras fallan: hay que salir en
        # vez de quedarse dibujando en el vacio.
        self.output_broken = False
        if ImageRenderer is not None:
            try:
                self.image = ImageRenderer(self)
            except Exception as error:  # noqa: BLE001
                self.image = None
                self.image_error = repr(error)
        # Solo modo imagen: si no hay renderizador, avisar y salir
        if self.image is None:
            reason = self.image_error or IMAGE_ERROR or self.tr("unknown_reason")
        elif not getattr(getattr(self.image, "gfx", None), "supported", False):
            reason = self.tr("no_graphics")
        else:
            reason = ""
        if reason:
            self.warn(f"modo imagen no disponible: {reason}")
            self.status_message = self.tr("image_unavailable", reason=reason)
        self.last_mode = ""
        self._demo_start = time.monotonic() - max(0.0, args.demo_offset)
        if self.demo:
            self._load_demo()
        self.update_size()

    # ---- utilidades de terminal -------------------------------------

    def _set_language(self, choice: str):
        """Fija el idioma de los textos de la ventana."""
        language = detect_language(choice)
        self.language = language
        self.texts = TEXTS.get(language, TEXTS["en"])

    def tr(self, key: str, **kwargs) -> str:
        """Texto de la ventana en el idioma elegido.

        Si la clave no existe se devuelve la clave: se ve al instante que
        falta una traduccion en vez de dejar un hueco en la ventana.
        """
        value = self.texts.get(key)
        if value is None:
            return key
        text = str(value)
        if kwargs:
            try:
                return text.format(**kwargs)
            except (IndexError, KeyError):
                return text
        return text

    def log(self, message: str):
        if not self.args.debug:
            return
        self.warn(message)

    def warn(self, message: str):
        """Anota un problema en el log de diagnostico (siempre, no solo con --debug)."""
        try:
            os.makedirs(CACHE_DIR, exist_ok=True)
            with open(os.path.join(CACHE_DIR, "debug.log"), "a", encoding="utf-8") as handle:
                handle.write(f"{time.strftime('%H:%M:%S')} {message}\n")
        except OSError:
            pass

    def update_size(self):
        size = shutil.get_terminal_size(fallback=(96, 30))
        # Las celdas reales mandan: la ventana puede tener menos de 30x12
        # celdas (por ejemplo con una fuente grande) y un minimo inventado
        # hace que cada fila se desborde y la letra se parta en trozos.
        width = size.columns if size.columns > 0 else 96
        height = size.lines if size.lines > 0 else 30
        if width != self.width or height != self.height:
            self.width = width
            self.height = height
            self.dirty = True

    # ---- datos --------------------------------------------------------

    def _load_demo(self):
        sample = [
            (0.0, "Luz de neón sobre la ciudad"),
            (4.6, "y el asfalto guarda tu nombre"),
            (9.4, "un tren vacío cruza el puente"),
            (14.2, "mientras la noche se deshace"),
            (19.0, "Si el tiempo vuelve a preguntar"),
            (23.8, "dile que aquí sigo esperando"),
            (28.6, "que la marea traiga tu voz"),
            (33.4, "y el silencio se vaya apagando"),
            (38.2, "Somos dos puntos en la oscuridad"),
            (43.0, "dos señales que no saben volver"),
            (47.8, "y aunque la ciudad se duerma"),
            (52.6, "yo sigo aquí, mirando al sur"),
            (57.4, "La radio suena en otra habitación"),
            (62.2, "con una canción que no sé nombrar"),
            (67.0, "todo se mueve, todo se queda"),
            (71.8, "como una ola contra el cristal"),
            (76.6, "Y si mañana no estoy"),
            (81.4, "recuerda lo que te di"),
            (86.2, "porque la vida es un viaje"),
            (91.0, "y yo ya decidí"),
        ]
        self.lines = [LyricLine(start, 4.6, text) for start, text in sample]
        self.source = "demo"
        # Sin busqueda: el modo demo es autonomo (ni al arrancar ni al
        # recargar se pide letra a internet).
        self.log("demo: letra de muestra, sin busqueda")
        self.synced = True
        self.state = "lyrics"
        self.track = Track("Eternamente", "Stranger Beats, Inexistente y BabyG", "Extraños Clika II", 96.0, "demo", "Playing")
        self.track.stamp = time.monotonic()
        self.demo_duration = 96.0
        self.active_index = 0
        self.last_active = -1
        self.moving = False
        self.scroll = 0.0
        self.scroll_to = 0.0
        self.scroll_from = 0.0

    def _demo_position(self):
        elapsed = (time.monotonic() - self._demo_start) % (self.demo_duration + 4)
        return min(elapsed, self.demo_duration), self.demo_duration

    def _apply_track(self, track: Track):
        # La clave basta para saber que es el mismo tema. Exigir ademas un
        # titulo hacia que un tema sin titulo (solo artista) se volviera a
        # buscar en cada sondeo, sin fin.
        if track.key == self.track_key and self.track_key:
            self.track = track
            return
        self.track = track
        self.track_key = track.key
        if not track.title and not track.artist:
            self.track_key = ""
            self.state = "idle"
            self.lines = []
            self.source = ""
            self.synced = False
            self.dirty = True
            return
        self.reload_lyrics(force=self.args.force)
        self.args.force = False

    def reload_lyrics(self, force: bool = False):
        track = self.track
        if not track.title and not track.artist:
            return
        cached = None if force else load_cache(track)
        if cached:
            self.lines, self.source, self.synced = cached
            self.state = "lyrics" if self.lines else "empty"
            self._snap_scroll()
            self.log(f"tema: {track.title} — {track.artist} (cache)")
            # La letra se muestra ya, pero si solo trae tiempos de línea se
            # busca en segundo plano una versión con tiempos por palabra.
            # Sin red de por medio el karaoke repartiría la línea a partes
            # iguales y no seguiría la voz.
            if (
                not lines_have_chars(self.lines)
                and not word_checked_recent(track)
            ):
                self.fetcher.start(track, force=True, upgrade=True)
                self.log("buscando una versión con tiempos por palabra")
        else:
            self.state = "loading"
            self.lines = []
            self.source = ""
            self.synced = False
            self.fetcher.start(track, force=force)
            self.last_fetch = time.monotonic()
            self.log(f"tema: {track.title} — {track.artist} (buscando)")
        self.dirty = True

    def _apply_fetched(self, lines, source, synced) -> bool:
        """Aplica un resultado de búsqueda sin pisar una letra igual o mejor.

        Una mejora en segundo plano puede llegar cuando la canción ya va
        por la mitad. Volver a aplicar la misma letra (o una peor) haría
        saltar el carrusel sin ganar nada, y una búsqueda fallida no debe
        borrar la letra que se está mostrando.
        """
        if not (self.track.title or self.track.artist):
            return False
        nueva_palabra = lines_have_chars(lines)
        actual_palabra = lines_have_chars(self.lines)
        if self.lines and not (nueva_palabra and not actual_palabra):
            if lines and not nueva_palabra:
                mark_word_checked(self.track)
            return False
        self.lines = lines
        self.source = source
        self.synced = synced
        self.state = "lyrics" if lines else "empty"
        self._snap_scroll()
        self.dirty = True
        if lines and not nueva_palabra:
            mark_word_checked(self.track)
        return True

    def _snap_scroll(self):
        self.last_active = -1
        self.active_index = 0
        self.scroll = 0.0
        self.scroll_from = 0.0
        self.scroll_to = 0.0
        self.scroll_duration = 0.0

    def _reload_config(self):
        cfg = load_settings()
        if self.args.direction:
            cfg["direction"] = self.args.direction
        if self.args.no_karaoke:
            cfg["karaoke"] = False
        if self.args.active_scale:
            cfg["active_scale"] = self.args.active_scale
        if self.args.accent:
            cfg["accent"] = self.args.accent
        # Los atajos guardan en segundo plano. Mientras el settings.toml no
        # recoja el valor, la configuracion trae el viejo: se mantiene el
        # cambio local para que la recarga no lo revierta.
        pending = getattr(self, "pending_overrides", None)
        if pending:
            for key, value in list(pending.items()):
                if cfg.get(key) == value:
                    del pending[key]
                else:
                    cfg[key] = value
        # Compara clave a clave: la igualdad de diccionarios puede fallar
        # por tipos (int vs float) y entonces los cambios se ignoran.
        if all(
            cfg.get(key) == self.cfg.get(key)
            for key in cfg
            if key in self.cfg
        ) and set(cfg.keys()) == set(self.cfg.keys()):
            return
        # Copia congelada de la configuracion anterior: comparar contra el
        # mismo diccionario que se va a reemplazar permite que cualquier
        # mutacion local (por ejemplo, la que hacia draw_image al fallar)
        # se confunda con una peticion nueva del usuario.
        previous = dict(self.cfg)
        # Invalida la cache de fuentes si cambio la familia o el tamaño.
        if (
            str(previous.get("font_family")) != str(cfg.get("font_family"))
            or int(previous.get("font_size", 0)) != int(cfg.get("font_size", 0))
        ):
            if self.image is not None:
                try:
                    self.image.invalidate_fonts()
                except Exception:  # noqa: BLE001
                    pass
            # La tipografía se cachea en el renderizador de imagen: al
            # cambiarla hay que invalidar la caché, no reiniciar nada.
        self.cfg = cfg
        self.direction = 1 if cfg["direction"] == "down" else -1
        self.karaoke = bool(cfg["karaoke"])
        self.spacing = int(cfg["spacing"])
        self.dirty = True
        self.log("ajustes: " + json.dumps(cfg, ensure_ascii=False))
        if (
            previous.get("width") != cfg["width"]
            or previous.get("height") != cfg["height"]
            or previous.get("anchor") != cfg["anchor"]
        ):
            # La geometría se aplica a la ventana viva, sin recrearla.
            if apply_geometry(cfg):
                self.log("geometría aplicada en caliente")

    def _poll_data(self):
        # Recarga de ajustes: vale tanto en modo demo como en modo real.
        if time.monotonic() - self.last_cfg > 0.5:
            self.last_cfg = time.monotonic()
            self._reload_config()

        if self.demo:
            position, duration = self._demo_position()
            now = time.monotonic()
            self.track.position = position
            self.track.duration = duration
            self.track.stamp = now
            self.track.status = "Playing"
            self.track_key = self.track.key
            return

        fresh = self._player.poll() if self._player else None
        if fresh is not None:
            self._apply_track(fresh)

        result = self.fetcher.take()
        if result is not None:
            lines, source, synced = result
            if self._apply_fetched(lines, source, synced):
                self.log(f"resultado: {len(lines)} líneas ({source})")

        if (
            self.state == "empty"
            and self.track.title
            and time.monotonic() - self.last_fetch > RETRY_SECONDS
        ):
            # La letra puede no estar disponible la primera vez (API caída o
            # canción recién añadida): se reintenta cada minuto.
            self.last_fetch = time.monotonic()
            self.fetcher.start(self.track, force=True)
            self.log("reintento automático de la letra")

        # (la recarga de ajustes ya se hizo arriba, vale para demo y real)

        if time.monotonic() - self.last_reload > 15:
            self.last_reload = time.monotonic()
            self.theme.reload()

    # ---- cálculo de la línea activa ----------------------------------

    def _position(self):
        if self.demo:
            position, _ = self._demo_position()
            return position
        if not self.track:
            return 0.0
        return self.track.current_position()

    def position(self):
        """Posición de reproducción con el desfase aplicado."""
        return max(0.0, self._position() + self.cfg["offset_ms"] / 1000.0)

    def _timed_lines(self):
        """(inicio, índice) de las líneas con tiempo, ordenado por inicio.

        Las líneas de una letra plain no tienen tiempo (-1). Si se mezclan
        con la búsqueda binaria, el orden deja de ser creciente y se resalta
        una línea que no suena.
        """
        pairs = [
            (line.start, index)
            for index, line in enumerate(self.lines)
            if line.start >= 0
        ]
        pairs.sort(key=lambda pair: pair[0])
        return pairs

    def next_timed_start(self, index):
        """Inicio de la siguiente linea con tiempo real (o None).

        Las lineas sin marca de tiempo valen -1: si el relleno del karaoke
        toma "la siguiente de la lista" como final, la linea activa se
        queda con un final de -1 (o se acorta de golpe) y el resaltado se
        descuadra. Aqui se busca el menor tiempo real posterior al de la
        linea, que es lo que marca cuando empieza la siguiente.

        Devuelve None si no hay ninguna linea con tiempo despues.
        """
        if index < 0 or index >= len(self.lines):
            return None
        actual = self.lines[index].start
        if actual < 0:
            # Una linea sin tiempo no tiene final por karaoke.
            return None
        siguiente = None
        for line in self.lines:
            if line.start > actual and (siguiente is None or line.start < siguiente):
                siguiente = line.start
        return siguiente

    def scroll_state(self, position):
        """(línea cantada, línea en el centro, progreso de la transición)."""
        if not self.lines:
            return 0, 0, 0.0
        timed = self._timed_lines()
        if not timed:
            return 0, 0, 0.0
        times = [start for start, _ in timed]
        # Sin tolerancia: la línea siguiente solo es la activa cuando
        # empieza de verdad. Si se adelantara, el final de la transición
        # volvería a progress 0 y el carrusel daría un tirón al llegar.
        slot = bisect.bisect_right(times, position) - 1
        slot = max(0, min(slot, len(timed) - 1))
        index = timed[slot][1]
        focus = index
        progress = 0.0
        # La transición suave es una duración fija (~0.9 s) y solo existe si
        # el usuario la ha activado: con `ghost` apagado el carrusel salta
        # de una línea a la siguiente sin animación.
        duration = GHOST_SECONDS if self.cfg["ghost"] else 0.0
        nxt = slot + 1
        if nxt < len(timed) and duration > 0:
            next_start = timed[nxt][0]
            gap = next_start - timed[slot][0]
            anticipation = min(duration, gap * 0.8) if gap > 0 else 0.0
            if anticipation > 0:
                start = next_start - anticipation
                if start <= position < next_start:
                    progress = ease_in_out((position - start) / anticipation)
                    focus = timed[nxt][1]
        return index, focus, progress

    def karaoke_amount(self, line, text, position, end) -> float:
        """Cuántos caracteres de la línea se han cantado, con decimales.

        Para el modo imagen el relleno es pixel-perfect: el avance se interpola
        dentro del carácter en curso. Con tiempos por carácter usa esos tiempos;
        sin ellos reparte la duración de la línea entre los caracteres.
        """
        length = len(text)
        if length <= 0:
            return 0.0
        chars = line.chars if line.chars and len(line.chars) >= length else []
        if chars:
            started = 0
            for value in chars[:length]:
                if value <= position:
                    started += 1
                else:
                    break
            if started <= 0:
                return 0.0
            if started >= length:
                return float(length)
            previous = chars[started - 1]
            following = chars[started]
            inner = 0.0
            if following > previous:
                inner = clamp((position - previous) / (following - previous), 0.0, 1.0)
            return started - 1 + inner
        start = line.start
        fraction = clamp((position - start) / max(0.35, end - start), 0.0, 1.0)
        return fraction * length

    def terminal_pixels(self):
        try:
            from graphics import terminal_cells

            return terminal_cells()[2:]
        except Exception:  # noqa: BLE001
            return 0, 0

    def _update_scroll(self, position):
        """El desplazamiento es función del tiempo de reproducción.

        El bloque empieza a moverse justo antes de que entre la línea nueva y
        termina exactamente cuando le toca, así que el movimiento es continuo
        y no un salto seco.
        """
        if not self.lines:
            return
        index, focus, progress = self.scroll_state(position)
        step = float(self.spacing)
        self.active_index = index
        self.last_active = index
        target = index * step
        self.moving = focus != index and progress > 0.0
        if self.moving:
            target = index * step + (focus - index) * step * progress
        self.scroll = target

    def draw_image(self, force=False):
        if self.image is None:
            # Sin renderizador no hay nada que dibujar: el aviso ya se dio al
            # arrancar y el bucle de --once termina solo.
            return
        if self.last_mode != "image":
            sys.stdout.write("\x1b[2J\x1b[H")
            sys.stdout.flush()
            self.last_mode = "image"
            self.log("modo: imagen")
        try:
            rendered = self.image.render()
        except OSError as error:
            # Terminal redimensionado o cerrado: no cuenta como fallo de
            # render, pero si esta cerrado hay que salir.
            self.log(f"escritura: {error!r}")
            self.output_broken = True
            return
        except Exception as error:  # noqa: BLE001
            import traceback

            self.image_failures = getattr(self, "image_failures", 0) + 1
            self.log(
                "imagen: " + repr(error) + "\n" + traceback.format_exc()
            )
            if self.image_failures >= 3:
                self.log("modo imagen desactivado tras varios fallos")
                self.image_disabled = True
                self.status_message = self.tr("image_disabled")
                self.last_mode = ""
            return
        if not rendered:
            # No se ha podido colocar la imagen (p. ej. sin tamaño en píxeles).
            self.image_failures = getattr(self, "image_failures", 0) + 1
            if self.image_failures >= 3:
                self.log("modo imagen desactivado: no se puede dibujar")
                self.image_disabled = True
            return
        self.image_failures = 0

    def draw(self, force=False):
        now = time.monotonic()
        # A 60 fps solo mientras el carrusel se mueve (transición suave): en
        # reposo, con el karaoke y el fondo, 30 fps sobran y la imagen pesa
        # menos en el canal de kitty.
        fps = MOTION_FPS if self.moving else IMAGE_FPS
        interval = 1.0 / fps
        if not force and now - self.last_draw < interval:
            return
        self.last_draw = now
        self.draw_image(force)

    # ---- teclado ------------------------------------------------------

    def _save_override(self, key, value, kind="string"):
        """Guarda un ajuste y lo deja escrito en el settings.toml.

        La capa de overrides es temporal: el panel la vuelca al cerrarse.
        Un atajo de la ventana no tiene panel que la vuelque, asi que el
        helper escribe tambien en el settings.toml: si no, el cambio se
        perderia al reiniciar la sesion.

        Ojo: escribir el settings.toml hace que Noctalia recargue la
        configuracion (y cierre el panel que estuviera abierto).
        """
        # realpath: el script suele lanzarse por el enlace simbolico de
        # ~/.local/bin, y el helper vive en bin/.
        helper = os.path.join(
            os.path.dirname(os.path.realpath(__file__)), "set-setting.py"
        )
        if not os.path.isfile(helper):
            self.log(f"no se encuentra el helper: {helper}")
            return
        # La escritura va en segundo plano: hasta que el settings.toml la
        # recoja, una recarga traeria el valor viejo y revertiria el atajo.
        pending = getattr(self, "pending_overrides", None)
        if pending is None:
            pending = {}
            self.pending_overrides = pending
        pending[key] = value
        try:
            subprocess.Popen(
                [
                    "python3",
                    helper,
                    "persist",
                    key,
                    str(value),
                    kind,
                ],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        except OSError as error:
            pending.pop(key, None)
            self.log(f"no se pudo guardar {key}: {error}")

    def _on_reload_signal(self, _signum, _frame):
        """Marca la recarga; el bucle la atiende en el siguiente cuadro."""
        self.reload_requested = True

    def _consume_reload(self) -> bool:
        """Atiende una recarga pedida por SIGUSR1 (una sola vez)."""
        if not getattr(self, "reload_requested", False):
            return False
        self.reload_requested = False
        if self.demo:
            self._load_demo()
            self.dirty = True
        elif self.track.title or self.track.artist:
            self.reload_lyrics(force=True)
        return True

    def handle_key(self, key: str) -> bool:
        if key in ("q", "Q", "\x03"):
            return False
        if key == " ":
            if self.track.player and self.track.player != "demo":
                # playerctl puede no estar instalado o fallar: la ventana
                # sigue viva y la tecla no se propaga.
                try:
                    subprocess.run(
                        ["playerctl", "-p", self.track.player, "play-pause"],
                        capture_output=True,
                        timeout=2,
                        check=False,
                    )
                    time.sleep(0.15)
                    if self._player:
                        self._player.poll(force=True)
                except (OSError, subprocess.SubprocessError):
                    pass
            return True
        if key in ("d", "D"):
            self.direction *= -1
            self.cfg["direction"] = "down" if self.direction > 0 else "up"
            self._save_override("direction", self.cfg["direction"], "string")
            self.dirty = True
            return True
        if key in ("k", "K"):
            self.karaoke = not self.karaoke
            self.cfg["karaoke"] = self.karaoke
            self._save_override("karaoke", self.karaoke, "bool")
            self.dirty = True
            return True
        if key in ("r", "R"):
            if self.demo:
                # En modo demo no se busca en internet: se recarga la letra
                # de muestra (buscarla haria cuatro peticiones a los
                # proveedores sin ningun sentido).
                self._load_demo()
                self.dirty = True
                return True
            if self.track.title or self.track.artist:
                self.reload_lyrics(force=True)
            return True
        return True

    def run(self):
        interactive = not self.args.once
        self._setup_terminal(interactive)
        self._announce_pid()
        # El visualizador es el fondo de la ventana: cava en modo real y
        # barras simuladas en demo (no hay audio que escuchar).
        visualizer = getattr(self, "visualizer", None)
        if visualizer is not None and not self.demo:
            visualizer.start()
        try:
            while not self.stop_requested:
                self.update_size()
                self._poll_data()
                self._consume_reload()
                # Con el desfase: si el scroll usara la posicion cruda, la
                # linea resaltada (que si usa el desfase) no seria la que
                # esta en el centro.
                position = self.position()
                self._update_scroll(position)
                self.draw(force=self.dirty)
                self.dirty = False
                if self.args.once or self.output_broken:
                    # La terminal se ha cerrado: se sale limpio en vez de
                    # quedarse dibujando en el vacio.
                    break
                for key in self._read_keys():
                    if not self.handle_key(key):
                        self.stop_requested = True
                        break
                # El bucle late a 60 Hz: draw() decide si toca dibujar a 60
                # (transición) o a 30 (reposo).
                time.sleep(1.0 / MOTION_FPS)
        finally:
            visualizer = getattr(self, "visualizer", None)
            if visualizer is not None:
                visualizer.stop()
            self._forget_pid()
            self._restore_terminal(interactive)

    # -- PID de la ventana -------------------------------------------------

    def _announce_pid(self):
        """Deja escrito el PID para que el panel pueda avisar a esta ventana.

        Sin esto, el panel tendria que buscar el proceso por su linea de
        comandos, y SIGUSR1 mata por defecto: un `pkill -f lyrics-carousel`
        alcanzaria tambien a un editor que tenga el fichero abierto.
        """
        try:
            os.makedirs(data_dir(), exist_ok=True)
            with open(pid_path(), "w", encoding="utf-8") as handle:
                handle.write(str(os.getpid()))
        except OSError as error:
            self.log(f"no se pudo guardar el PID: {error!r}")

    def _forget_pid(self):
        """Borra el PID: la ventana ya no está, señalizarla no tiene sentido."""
        try:
            os.unlink(pid_path())
        except OSError:
            pass

    def _setup_terminal(self, interactive: bool):
        if not interactive or not sys.stdin.isatty():
            return
        import termios
        import tty

        self._term_fd = sys.stdin.fileno()
        self._term_attrs = termios.tcgetattr(self._term_fd)
        tty.setcbreak(self._term_fd)
        sys.stdout.write("\x1b[?1049h\x1b[?25l\x1b[2J\x1b[H")
        sys.stdout.flush()

    def _restore_terminal(self, interactive: bool):
        if not interactive or not sys.stdin.isatty():
            return
        import termios

        try:
            termios.tcsetattr(self._term_fd, termios.TCSADRAIN, self._term_attrs)
        except (OSError, termios.error):
            pass
        sys.stdout.write("\x1b[0m\x1b[?25h\x1b[?1049l")
        sys.stdout.flush()

    def _read_keys(self):
        if not sys.stdin.isatty():
            return []
        try:
            ready, _, _ = select.select([sys.stdin], [], [], 0)
        except (OSError, ValueError):
            return []
        if not ready:
            return []
        try:
            data = os.read(sys.stdin.fileno(), 16)
        except OSError:
            return []
        return list(data.decode("utf-8", "ignore"))


# --------------------------------------------------------------------------
# CLI
# --------------------------------------------------------------------------

def diagnostics() -> dict:
    """Estado del script: rutas, modulos disponibles y ajustes en uso.

    Sirve para diagnosticar sin abrir la interfaz (lo usa el autotest) y
    comprueba que los modulos hermanos se encuentran aunque el script se
    lance por el enlace simbolico de ~/.local/bin.
    """
    helper = os.path.join(_HERE, "set-setting.py")
    try:
        import graphics  # noqa: F401

        graphics_ok = True
    except Exception:  # noqa: BLE001
        graphics_ok = False
    return {
        "script": os.path.abspath(__file__),
        "bin_dir": _HERE,
        "helper": helper,
        "helper_exists": os.path.isfile(helper),
        "image_renderer": ImageRenderer is not None,
        "image_error": IMAGE_ERROR,
        "graphics": graphics_ok,
        "version": VERSION,
        "state_dir": state_dir(),
        "settings": settings_path(),
        "overrides": overrides_path(),
        "data_dir": data_dir(),
    }


def main():
    parser = argparse.ArgumentParser(
        prog=APP,
        description="Carrusel vertical de la letra que está sonando.",
    )
    parser.add_argument("--direction", choices=("down", "up"), default=None, help="sentido del carrusel (por defecto: el del plugin)")
    parser.add_argument("--player", default="", help="nombre de reproductor MPRIS (por defecto: el que esté sonando)")
    parser.add_argument("--no-karaoke", action="store_true", help="no rellenar la línea activa carácter a carácter")
    parser.add_argument("--active-scale", type=float, default=None, help="tamaño de la línea activa")
    parser.add_argument("--accent", default=None, help="color de la línea activa")
    parser.add_argument("--no-keys", action="store_true", help="ocultar la ayuda de teclas")
    parser.add_argument(
        "--lang",
        choices=("auto", "en", "es"),
        default=None,
        help="idioma de los textos de la ventana (por defecto: el del plugin)",
    )
    parser.add_argument("--demo", action="store_true", help="letra de demostración sin reproductor")
    parser.add_argument("--demo-offset", type=float, default=0.0, help=argparse.SUPPRESS)
    parser.add_argument("--once", action="store_true", help="dibujar un cuadro y salir")
    parser.add_argument("--force", action="store_true", help="ignorar la caché al buscar letra")
    parser.add_argument("--debug", action="store_true", help="escribir diagnóstico en la caché")
    parser.add_argument("--clear-cache", action="store_true", help="borrar la caché de letras y salir")
    parser.add_argument(
        "--diagnostics",
        action="store_true",
        help="imprimir el estado del script (rutas, modulos, ajustes) y salir",
    )
    parser.add_argument("--version", action="version", version=f"{APP} {VERSION}")
    args = parser.parse_args()

    try:
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")
    except AttributeError:
        pass

    if args.clear_cache:
        if os.path.isdir(CACHE_DIR):
            for name in os.listdir(CACHE_DIR):
                # El log de avisos no es cache: borrarlo dejaria al usuario
                # sin diagnostico justo cuando acaba de vaciar la cache.
                if name == "debug.log":
                    continue
                try:
                    os.remove(os.path.join(CACHE_DIR, name))
                except OSError:
                    pass
        print(f"caché borrada: {CACHE_DIR}")
        if not args.diagnostics:
            return 0

    if args.diagnostics:
        print(json.dumps(diagnostics(), ensure_ascii=False, sort_keys=True))
        return 0

    os.makedirs(CACHE_DIR, exist_ok=True)
    app = LyricsCarousel(args)

    def on_signal(_signum, _frame):
        app.stop_requested = True

    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        try:
            signal.signal(sig, on_signal)
        except (ValueError, OSError):
            pass
    try:
        signal.signal(signal.SIGUSR1, app._on_reload_signal)
    except (ValueError, OSError, AttributeError):
        pass

    try:
        app.run()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
